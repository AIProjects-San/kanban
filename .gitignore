*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out
test
prompt

server.log
# Skills directory
/skills/
# database artifacts
*.db
*.db-journal

# session artifacts
tool-results/
dev.log
server.log

# agent workspace directories (deliverables + uploads — never commit)
/upload/
/download/
e2e/artifacts/

