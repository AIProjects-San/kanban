/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real credentials.
# PR-45: `.env.example` documents the boot contract and IS committed;
# the negation must stay directly below the glob.
.env*
!.env.example

# vercel
.vercel


