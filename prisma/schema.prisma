// Fernly — Project Management Admin Dashboard schema
// PostgreSQL datasource (Supabase), Prisma Client JS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Canonical provider is postgresql — CI's e2e job (prisma migrate deploy
  // against a Postgres 16 service container), docker-compose and the Supabase
  // production database all run the migration history on PostgreSQL.
  //
  // The sandbox preview runs the SAME models on SQLite (DATABASE_URL=file:./dev.db,
  // applied with prisma db push): scripts/run-with-env.sh detects a file: URL,
  // generates the gitignored prisma/schema.local.prisma variant and points the
  // Prisma CLI at it — this committed provider must NEVER be flipped to
  // "sqlite" (commit 76e2e51 leaked the local override and broke every CI run
  // with Prisma P1012 until the ADR-008 fix). See docs/DECISIONS.md ADR-008.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth + Profile
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  // PR-48 (auth migration Phase 1) — Better Auth core user fields. The app
  // itself never reads them: emailVerified is inert (the workspace has no
  // email-verification gate) and image is unused (avatars are colors), but
  // the 1.7 adapter selects both on every mapped read, so they must exist.
  emailVerified Boolean   @default(false)
  image        String?
  role         String    @default("MEMBER") // ADMIN | MANAGER | MEMBER — see lib/rbac.ts. Defaulting to MEMBER (was "Project Lead") closes L-P0-13.
  // L-P0-8 — session revocation. Incremented on password change and role
  // change. The JWT callback rejects tokens whose tokenVersion is stale,
  // so a stolen cookie is invalidated the moment the user rotates their
  // password or an admin rotates their role.
  tokenVersion Int       @default(0)
  timezone     String    @default("Pacific/Auckland")
  bio          String    @default("")
  avatarColor  String    @default("forest")
  // L-P0-14 — soft delete. Set by deleteUser instead of a hard delete, so
  // messages and team-member references don't dangle. Read paths filter
  // `where: { deletedAt: null }`.
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // ---------------------------------------------------------------------
  // Reporting hierarchy (docs/CODE_REVIEW.md §6 — user hierarchy).
  // `managerId` is the user this account reports to (its parent in the
  // org chart). Null = root (workspace owner / unmanaged admin). The
  // relation is a self-reference with onDelete: SetNull so deleting a
  // manager promotes their direct reports to roots rather than cascading
  // a delete. The chain is walked by lib/hierarchy.ts.
  // ---------------------------------------------------------------------
  managerId     String?
  manager       User?   @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports User[]  @relation("UserManager")

  projectAssignments ProjectAssignment[]
  settings           UserSettings?

  // Stable-identity links (see docs/CODE_REVIEW.md §6.1): authorization
  // decisions must NEVER be made on human-readable names — two users can
  // share a name. These relations carry the authoritative identity.
  ownedProjects Project[]   @relation("ProjectOwner")
  memberProfile TeamMember? @relation("MemberProfile")

  // Personal notifications routed to this user (null-recipient rows are
  // workspace-wide broadcasts instead — see the Notification model).
  notifications Notification[]

  // Per-recipient message read-state rows (L-P0-2 fix).
  messageReads MessageRead[]

  // L-P0-11 — password reset tokens (single-use, time-boxed).
  passwordResetTokens PasswordResetToken[]

  // PR-48 — Better Auth DB-backed sessions + credential accounts.
  sessions Session[]
  accounts Account[]

  // P36 (EM-21) — identification document rows (the EmployeeDocument
  // lifecycle: REQUESTED → RECEIVED → VERIFIED | REJECTED).
  employeeDocuments EmployeeDocument[] @relation("EmployeeDocuments")

  // P37 (EM-18) — the employee's structured skill-map rows.
  skillMap EmployeeSkill[] @relation("EmployeeSkillMap")

  // P39 (EM-16 advances half) — salary advances issued to this employee.
  salaryAdvances SalaryAdvance[] @relation("SalaryAdvances")

  // Phase 1B (G8) — the employee's effective-dated salary assignment
  // timeline (the pay history; see SalaryStructureAssignment).
  salaryStructureAssignments SalaryStructureAssignment[]

  // P1 G6 — the employee's approved employment-change documents (see
  // EmployeeTransfer / EmployeePromotion below; the effective-dated,
  // approval-gated writers ahead of EmployeePropertyHistory).
  employeeTransfers  EmployeeTransfer[]
  employeePromotions EmployeePromotion[]

  @@index([managerId])
}

// ---------------------------------------------------------------------------
// PR-48/PR-49 (auth migration) — Better Auth 1.7 table set.
// docs/AUTH_MIGRATION_PLAN.md §5: added alongside the existing User
// (mapped, not duplicated — `user.modelName: "User"`). Since the PR-49
// cleanup these tables are THE session/credential store (the NextAuth v4
// JWT stack is removed). Credentials themselves stay on User.passwordHash
// (the single source of truth) — the sign-in bridge syncs 1.7 credential
// Account rows lazily (spike finding F3).
// ---------------------------------------------------------------------------

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  // 1.7 credential rows: providerId "credential", accountId = user id,
  // password = mirror of User.passwordHash (synced by the sign-in bridge).
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// User settings — per-user preferences stored in the DB so they follow the
// user across machines (theme, dark mode, notification toggles).
// ---------------------------------------------------------------------------

model UserSettings {
  userId        String   @id
  accent        String   @default("forest") // forest | ocean | plum | ember
  dark          Boolean  @default(false)
  // PR-65 — per-user sidebar rail (compact icon-only layout). Previously
  // browser-localStorage only, which every account on that browser shares.
  sidebarRail   Boolean  @default(false)
  notifEmail    Boolean  @default(true)
  notifPush     Boolean  @default(true)
  notifMentions Boolean  @default(true)
  notifDueToday Boolean  @default(true)
  notifWeekly   Boolean  @default(false)
  notifProduct  Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

model Project {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  status      String    @default("RUNNING") // RUNNING | ENDED | PENDING | PAUSED
  priority    String    @default("MEDIUM") // HIGH | MEDIUM | LOW
  dueDate     DateTime?
  progress    Int       @default(0) // 0..100
  color       String    @default("forest") // forest | ocean | plum | ember | slate
  // Denormalized display copy of the owner's name. Authority lives in
  // ownerUserId — ownerName must never be used for authorization.
  ownerName   String    @default("")
  ownerUserId String?
  ownerUser   User?     @relation("ProjectOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  // L-P0-14 — soft delete. Set by deleteProject instead of a hard delete, so
  // tasks keep their projectId reference and don't become orphans.
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks       Task[]
  timeEntries TimeEntry[]
  assignments ProjectAssignment[]

  // L-P0-5 — secondary indexes on the columns every scoped query filters on.
  @@index([ownerUserId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Tasks (Kanban)
// ---------------------------------------------------------------------------

model Task {
  id              String      @id @default(cuid())
  title           String
  description     String      @default("")
  status          String      @default("TODO") // TODO | IN_PROGRESS | IN_REVIEW | DONE
  priority        String      @default("MEDIUM") // HIGH | MEDIUM | LOW
  tag             String      @default("FRONTEND") // FRONTEND | BACKEND | DESIGN | QA | MARKETING
  dueDate         DateTime?
  order           Int         @default(0)
  // Board enhancement — required (estimated) time for this task, in minutes.
  // 0 = no estimate. Actual time spent lives in TimeEntry rows linked via
  // TimeEntry.taskId (aggregated at read time as spentHours).
  estimateMinutes Int         @default(0)
  projectId       String?
  assigneeId      String?
  project         Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignee        TeamMember? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  // Task ↔ Bug traceability: bugs may reference the task they belong to
  // (Bug.taskId). The relation is owned by Bug — a task can have many bugs,
  // a bug belongs to at most one task.
  timeEntries     TimeEntry[]
  bugs            Bug[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // L-P0-5 — secondary indexes on the columns every scoped query filters on.
  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Team Members
// ---------------------------------------------------------------------------

model TeamMember {
  id             String    @id @default(cuid())
  name           String
  role           String
  department     String    @default("ENGINEERING") // ENGINEERING | DESIGN | MARKETING | MANAGEMENT
  email          String    @unique
  avatarColor    String    @default("forest")
  online         Boolean   @default(false)
  openTasks      Int       @default(0)
  completedTasks Int       @default(0)
  workload       Int       @default(0) // 0..100 percent
  // Link to the User account this member record represents (nullable:
  // roster entries may exist without a login). Unique: one account maps to
  // at most one roster entry.
  userId         String?   @unique
  user           User?     @relation("MemberProfile", fields: [userId], references: [id], onDelete: SetNull)
  // L-P0-14 — soft delete. Set by deleteUser alongside the User soft-delete.
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tasks       Task[]
  timeEntries TimeEntry[]
}

// ---------------------------------------------------------------------------
// Calendar Events
// ---------------------------------------------------------------------------

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  date        DateTime
  time        String   @default("09:00")
  durationMin Int      @default(60)
  type        String   @default("MEETING") // MEETING | DEADLINE | REVIEW | SOCIAL | FOCUS
  location    String   @default("")
  createdAt   DateTime @default(now())

  // F2.10 (F-R6) — interview reminders link to their event so a reschedule
  // can delete the stale pair instead of orphaning it.
  reminders    Reminder[]

  // PR-16 — the dashboard's upcoming-events window and the ICS export both
  // filter + order on date; the model previously had zero indexes.
  @@index([date])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("INFO") // INFO | SUCCESS | WARNING | TASK | MENTION
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Per-user routing (docs/CODE_REVIEW.md §6.2): rows with a recipient are
  // private to that user — only they see them and only they can mark them
  // read. Rows with a null recipient are workspace-wide broadcasts: visible
  // to everyone, and only curatable (mark read/unread) by role:manage
  // holders, since flipping a broadcast's read flag affects every viewer.
  recipientUserId String?
  user            User?   @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, read])
  // PR-16 — the dashboard feed orders every user's notifications by
  // createdAt DESC; the composite with recipientUserId serves the common
  // `recipient = me OR null` + newest-first query.
  @@index([recipientUserId, createdAt])
  // P25 (PL-02) — deterministic dedup key for SCHEDULED notifications
  // (the engagement digests: `ENGAGEMENT:BIRTHDAY:2026-11-10` etc). Unique
  // across the table, so a createMany({ skipDuplicates }) re-run of the
  // daily job writes nothing — the same discipline the leave-allocation
  // job gets from its ledger sourceIds, lifted into the notification
  // surface. Null (the default) = an ordinary interactive notification;
  // both SQLite and Postgres allow many nulls under a UNIQUE index.
  sourceKey String? @unique
}

// ---------------------------------------------------------------------------
// Time Tracking
// ---------------------------------------------------------------------------

model TimeEntry {
  id          String      @id @default(cuid())
  projectId   String?
  memberId    String?
  // Board enhancement — optional link to the Task this time was spent on.
  // Task-level time logs are written by logTaskTime; the member is always
  // derived from the session (never client-supplied).
  taskId      String?
  date        DateTime
  hours       Float       @default(0)
  description String      @default("")
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  member      TeamMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  task        Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())

  // L-P0-5 — secondary indexes on the columns every scoped query filters on.
  @@index([memberId])
  @@index([projectId])
  @@index([date])
  @@index([taskId])
}

// ---------------------------------------------------------------------------
// Reminders (Dashboard widget)
// ---------------------------------------------------------------------------

model Reminder {
  id        String   @id @default(cuid())
  title     String
  dueDate   DateTime
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  // Owner of the reminder. Set = personal reminder visible only to that
  // user. Null = legacy workspace-wide row (retained for back-compat);
  // PR-52 stopped surfacing null-owner rows on the dashboard — reminders
  // are personal todos, never broadcasts — but the column stays nullable
  // so old data isn't lost on migrate. See dashboard.ts + reminders.ts.
  ownerId   String?

  // F2.10 (F-R6) — when this reminder belongs to a calendar event (the
  // interviewer's interview reminder), the event it was created for. A
  // reschedule deletes the old pair via this link; null = standalone
  // personal reminder (the pre-F2.10 shape).
  eventId   String?
  event     CalendarEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // PR-16 — the dashboard widget filters on ownerId (personal vs broadcast);
  // the model previously had zero indexes.
  @@index([ownerId])
  @@index([eventId])
}

// ---------------------------------------------------------------------------
// Messages (Team messaging — inbox + sent + threads)
// ---------------------------------------------------------------------------

model Message {
  id                String    @id @default(cuid())
  // direction is now DERIVED per-viewer (recipientUserId === me ? "IN" : "OUT")
  // — see L-P0-2 fix. The column is retained for backward-compat with seed
  // data and remains set to "OUT" by sendMessage (the sender's POV at write
  // time). New code MUST NOT trust this column for viewer-relative logic.
  direction         String // "IN" (to current user) | "OUT" (from current user)
  threadId          String // groups messages in the same conversation
  memberId          String? // the TeamMember this conversation is with
  senderUserId      String    @default("") // User.id of the sender
  recipientUserId   String    @default("") // User.id of the recipient
  senderName        String // display name of sender
  senderAvatarColor String    @default("forest")
  senderRole        String    @default("")
  recipientName     String // display name of recipient
  subject           String
  body              String
  // Legacy single-row read flag. Retained for backward-compat with seed rows
  // but new messages do NOT use it for read tracking — see MessageRead.
  read              Boolean   @default(false)
  // L-P0-14 — soft delete. Set by deleteMessage instead of a hard delete.
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())

  // Per-recipient read state (L-P0-2 fix). A row here means the recipient
  // has marked this message as read. The sender's own copy is implicitly
  // read (you wrote it). The legacy `read` column above is kept only for
  // seed-data compat.
  readBy MessageRead[]

  @@index([threadId])
  @@index([direction])
  @@index([recipientUserId])
  @@index([senderUserId])
  // PR-16 — the dashboard inbox orders messages by createdAt DESC on every
  // page load.
  @@index([createdAt])
}

// Per-recipient message read state. Each row records that `userId` has read
// `messageId`. Compound unique prevents duplicates; cascade delete keeps
// the table clean when a user or message is removed.
model MessageRead {
  id        String   @id @default(cuid())
  userId    String
  messageId String
  readAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  @@index([userId])
  @@index([messageId])
}

// ---------------------------------------------------------------------------
// Audit Log — immutable trail of every mutating action in the workspace
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String   @default("") // User.id of who did it
  actorName   String // display name at the time of the action
  actorRole   String   @default("") // ADMIN | MANAGER | MEMBER | SYSTEM
  action      String // e.g. "task.created", "project.deleted", "auth.signed_in"
  entityType  String // TASK | PROJECT | MEMBER | EVENT | MESSAGE | USER | ROLE | REMINDER | TIME | AUTH | NOTIFICATION
  entityId    String   @default("")
  entityLabel String   @default("") // human-readable label of the affected record
  detail      String   @default("") // full human-readable sentence for the timeline
  // P1 (production-readiness re-audit) — source IP + user agent for
  // post-incident forensics. Both nullable so existing rows + the
  // `auth.signed_in` event path (which doesn't always have a UA) still
  // work. The IP is stored as-is (the proxy already extracted it from
  // x-forwarded-for); hash it at read time if you need to export logs.
  ipAddress   String?  @default("")
  userAgent   String?  @default("")
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([entityType])
  @@index([actorId])
  // PR-16 — the entity-history panel filters on (entityType, entityId); the
  // single-column entityType index left the entityId discrimination to a
  // scan inside every entity-type group.
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Project Assignments — which users are allocated to which projects.
// This is the explicit "assign user to project" relation, separate from
// ownership (Project.ownerName) and task-based association (Task.assigneeId).
// A user assigned to a project can see it in their dashboard and tasks view,
// even if they don't own it or have tasks in it yet.
// ---------------------------------------------------------------------------

model ProjectAssignment {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("MEMBER") // OWNER | MEMBER
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Workspace — single-row table holding workspace-level settings.
// All "default X" values that were previously hardcoded move here so admins
// can configure them without a code deploy.
// ---------------------------------------------------------------------------

model Workspace {
  id                   String   @id @default("default")
  name                 String   @default("Fernly Workspace")
  defaultTimezone      String   @default("Pacific/Auckland")
  defaultUserRole      String   @default("MEMBER")
  defaultDepartment    String   @default("ENGINEERING")
  defaultAvatarColor   String   @default("forest")
  defaultJobTitle      String   @default("Team Member")
  minPasswordLength    Int      @default(8)
  workloadFullCapacity Int      @default(6)
  auditLogLimit        Int      @default(300)
  // Deep-dive review F-09 — retention window for pruneAuditLogs, in days.
  // Distinct from auditLogLimit (the UI display limit): the previous code
  // conflated the two, so changing the display limit silently changed the
  // retention window. 180 days default, clamped to >= 30 at read time.
  auditRetentionDays   Int      @default(180)
  entityHistoryLimit   Int      @default(50)
  dashboardNotifLimit  Int      @default(20)
  // R6 — the domain for deterministic employee emails when a candidate
  // joins: <first>.<last>@hiringEmailDomain (collisions get a numeric
  // suffix). Default matches the product's own domain.
  hiringEmailDomain    String   @default("fernly.app")
  // F2.10 (F-R9/E5) — the joining gate: when true, markJoined refuses while
  // any mandatory document is un-VERIFIED or any background check is
  // non-terminal (INITIATED/IN_REVIEW), mirroring the benchmark's
  // required_for_employee_creation. Default true (the gated behavior IS the
  // epic's point); workspaces that want the old advisory flow can turn it
  // off in Settings → General.
  joiningGateEnabled   Boolean  @default(true)
  // AT-B02/B03 (S2) — the reference day for late/early flags + working
  // hours ("HH:MM" 24-hour). Until shifts land (F3.5) the workspace default
  // day defines "late"; the rule itself is pure (lib/attendance-flags.ts)
  // and this row owns the instance (policy-as-data).
  attendanceDayStart  String   @default("09:00")
  attendanceDayEnd    String   @default("17:30")
  // PR-B07 (S4) — consider_unmarked_attendance_as, as workspace data.
  // IGNORED (default) = the pre-S4 semantics byte-for-byte: absence of
  // attendance data is not absence. ABSENT = the LOP derivation charges
  // unmarked working days (inside the employment window) as absent.
  unmarkedAttendanceMode String @default("IGNORED") // IGNORED | ABSENT
  // PR-B23 (S7) — the payslip rounding policy. ROUND_2DP (default) = the
  // historical discipline, no rounding line. ROUND_NET_NEAREST = every slip
  // carries an auto "Rounding" line bringing net to the nearest whole
  // dollar (the benchmark's rounded-total row as visible money).
  payrollRoundingMode  String   @default("ROUND_2DP") // ROUND_2DP | ROUND_NET_NEAREST
  // P9 (PR-B26) — pay attendance overtime into payroll: when on, run
  // creation sums each employee's derived overtimeMinutes over the period
  // and emits an "Overtime" earning line priced from the structure's
  // monthly gross (÷ working days ÷ 8h — the gross-basis rate). Default
  // OFF: overtime pay is a policy choice, never a surprise line.
  overtimePayEnabled  Boolean  @default(false)
  // P16 (PR-11) — the fiscal year YTD basis for payslip aggregates. 1 =
  // calendar year (the default — zero behavior change, the pre-P16
  // semantics byte-for-byte); e.g. 4 = the April–March fiscal year (the NZ
  // convention the demo seeds). The pure fiscalYearOf helper
  // (lib/payroll-windows.ts) resolves any date into its fiscal year; the
  // aggregates kernel resets YTD at the fiscal boundary instead of January
  // 1. MTD stays the calendar month regardless.
  fiscalYearStartMonth Int     @default(1)
  // P17 (PR-B27) — the proration basis switch (the benchmark's
  // payroll_based_on): HYBRID (default — leave-wins: an approved span
  // charges its salary-fraction complement, otherwise the attendance mark
  // decides), LEAVE (spans only — attendance marks never charge), or
  // ATTENDANCE (marks only — leave never charges). Pure knob consumed by
  // lib/lop-derivation.ts at run/slip creation; default HYBRID = the
  // pre-P17 semantics byte-for-byte.
  lopBasisMode        String   @default("HYBRID") // HYBRID | LEAVE | ATTENDANCE
  // P17 (PR-B25) — show each employee's live leave balances on the payslip
  // (the benchmark's show_leave_balances_in_salary_slip). Read-time: the
  // balances ride getPayrollRun/getMyPayslips payloads and the payslip
  // modal renders the box; nothing is snapshotted onto the slip.
  showLeaveBalancesOnSlip Boolean @default(false)
  // P18 (PR-B16) — email each payslip when its run locks: one PAYSLIP
  // outbox row per slip queued in the lock transaction, delivered
  // best-effort after it (the S17 discipline). HTML summary only — the
  // mailer has no attachment support, so the PDF itself stays the
  // download-only decision §9.2. Default OFF = the pre-P18 silence.
  emailPayslipsOnLock  Boolean @default(false)
  // P21 (LV-T01/LV-T02) — opt-in leave email notifications: when true, the
  // leave chain queues LEAVE_PENDING (approvers, request created) and
  // LEAVE_DECIDED (requester, decided) outbox rows beside the unconditional
  // in-app notifications, delivered best-effort (the P18 discipline).
  // Default OFF = the F-R17 zero-mail posture.
  emailLeaveNotifications Boolean @default(false)
  // P25 (PL-02/EM-23/EM-J01–03) — the engagement reminder switches (the
  // benchmark HR Settings' reminders block, incl. its
  // stop-birthday-reminders field). The three in-app digests default ON
  // (the benchmark ships them on; they are single broadcast rows per day
  // and only fire when the daily cron route runs — no scheduler, no rows).
  remindBirthdays          Boolean @default(true)
  remindAnniversaries      Boolean @default(true)
  remindHolidays           Boolean @default(true)
  // EM-J03 — how many days ahead of each holiday the reminder fires (the
  // daily job matches `holidayDate - today == daysAhead` exactly, so each
  // holiday reminds exactly once; clamped 1-30 at read time).
  holidayReminderDaysAhead Int    @default(7)
  // P25 — the EMAIL half of the engine (one digest outbox row per live
  // member per due event, rendered through the P24 template registry).
  // Default OFF = the F-R17 zero-mail posture; the outbox honesty records
  // SKIPPED rows when no provider is configured.
  emailEngagementReminders Boolean @default(false)
  // P26 (PL-03/RJ-B18) — the interview reminder switches. The in-app nudge
  // defaults ON (the benchmark ships interview reminders on): the daily
  // scheduler's interview pass writes ONE notification per interviewer per
  // same-day scheduled interview — a personal row, never a broadcast. Only
  // fires when the daily cron route runs: no scheduler, no rows.
  remindInterviews        Boolean @default(true)
  // P26 — the EMAIL half of the interview pass (one outbox row per newly
  // nudged interview, rendered through the P24 template registry). Default
  // OFF = the F-R17 zero-mail posture.
  emailInterviewReminders Boolean @default(false)
  // P31 (LV-J02 / LV-09's remainder) — the encashment auto-draft switch
  // (the benchmark's daily generate_leave_encashment job, whose HR Settings
  // enablement gates the whole pass). When ON, the daily dispatcher's
  // encashment pass drafts ONE LeaveEncashment request per (member ×
  // encashable type × year) whose ledger balance exceeds the type's
  // non-encashable floor — quarter-stepped, capped by maxEncashableDays,
  // landing PENDING in the HR decision queue (the S14 approver chain
  // decides; approval consumes days through the same P2 transaction).
  // Default OFF: drafting encashment requests on members' behalf is a
  // workspace policy choice, never a surprise queue row. One live draft
  // per pair; a REJECTED draft stands for the year (the documented
  // house discipline — no daily re-draft after a no).
  autoLeaveEncashment    Boolean @default(false)
  // P33 (EM-B02) — the retirement-age display knob (the benchmark's HR
  // Settings retirement_age feeding the Employee's retirement_date
  // projection). NULL = not configured → the directory's profile modal
  // renders no projection (the pre-P33 silence); when set (40–80), the
  // modal projects each member's retirement from birthDate + this age.
  // Display-only by design: nothing gates on it (the retirement-age
  // CONCEPT was declined; this is the display field the sweep's P33 row
  // scopes).
  retirementAge         Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// DB-backed domain enums — admins can add/rename/reorder/customize colors
// for task statuses, project statuses, event types, tags, priorities, and
// departments. Each table is seeded with the defaults from lib/config.ts.
//
// The TS literal unions (TaskStatus, ProjectStatus, etc.) are kept as
// "known defaults" — DB rows can extend them additively. Consumers use
// `string` at runtime and look up the label/color from the DB-driven list.
// ---------------------------------------------------------------------------

model TaskStatusConfig {
  id          String  @id @default(cuid())
  key         String  @unique
  label       String
  accentClass String  @default("bg-zinc-400")
  sortOrder   Int     @default(0)
  isTerminal  Boolean @default(false) // true = DONE-like (no further transitions expected)
  isVisible   Boolean @default(true)
}

model ProjectStatusConfig {
  id         String  @id @default(cuid())
  key        String  @unique
  label      String
  badgeClass String  @default("bg-muted text-muted-foreground")
  dotClass   String  @default("bg-muted-foreground")
  sortOrder  Int     @default(0)
  isVisible  Boolean @default(true)
}

model EventTypeConfig {
  id        String  @id @default(cuid())
  key       String  @unique
  label     String
  dotClass  String  @default("bg-primary")
  bgClass   String  @default("bg-primary/10")
  sortOrder Int     @default(0)
  isVisible Boolean @default(true)
}

model TaskTagConfig {
  id        String  @id @default(cuid())
  key       String  @unique
  label     String
  color     String  @default("oklch(0.6 0.05 250)") // oklch string for inline style
  sortOrder Int     @default(0)
  isVisible Boolean @default(true)
}

model PriorityConfig {
  id        String  @id @default(cuid())
  key       String  @unique
  label     String
  color     String  @default("oklch(0.6 0.05 250)")
  sortOrder Int     @default(0)
  isVisible Boolean @default(true)
}

model DepartmentConfig {
  id        String  @id @default(cuid())
  key       String  @unique
  label     String
  sortOrder Int     @default(0)
  isVisible Boolean @default(true)
}

// ---------------------------------------------------------------------------
// DB-backed RBAC — roles and permissions are admin-configurable.
// The ROLE_PERMISSIONS matrix from lib/rbac.ts is replaced by the
// RolePermission join table. System roles (ADMIN/MANAGER/MEMBER) are seeded
// with isSystem=true and cannot be deleted (but their permissions can be
// edited).
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String   @default("")
  iconName    String   @default("Shield") // Lucide icon name
  badgeClass  String   @default("bg-muted text-muted-foreground")
  isSystem    Boolean  @default(false) // system roles can't be deleted
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String   @default("")
  group       String   @default("General") // for admin UI grouping
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// ---------------------------------------------------------------------------
// L-P0-11 — Password reset tokens.
//
// Single-use, time-boxed tokens for self-service password reset. The raw
// token is sent to the user via email; only the SHA-256 hash is stored, so
// a DB leak cannot be replayed. `usedAt` marks the token as consumed (one
// use only); `expiresAt` caps the window (default 1 hour).
// ---------------------------------------------------------------------------

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 hash of the raw token. The raw token is NEVER stored — only sent
  // via email. Lookup is by hash, so an attacker who reads the DB cannot
  // reconstruct a usable token.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  // PR-16 — the daily maintenance purge deletes expired/used tokens by
  // expiresAt; without the index that is a full-table scan on every run.
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Bug Tracking — QA engineers raise bugs; developers work them through a
// full lifecycle (New → Triaged → In Progress → In Review → Resolved →
// Closed, with Reopened). Bugs can link to a Project and/or Task for
// traceability. Comments support discussion; the audit log captures every
// status change (bug.created, bug.assigned, bug.status_changed,
// bug.resolved, bug.reopened, bug.closed).
// ---------------------------------------------------------------------------

model Bug {
  id               String    @id @default(cuid())
  title            String
  description      String    @default("")
  // Structured reproduction steps (QA fills these in).
  stepsToReproduce String    @default("")
  expectedBehavior String    @default("")
  actualBehavior   String    @default("")
  // Severity = impact on the system; Priority = order to fix.
  severity         String    @default("MAJOR") // CRITICAL | MAJOR | MINOR | TRIVIAL
  priority         String    @default("P2") // P0 | P1 | P2 | P3
  // Lifecycle: NEW → TRIAGED → IN_PROGRESS → IN_REVIEW → RESOLVED → CLOSED
  //            (RESOLVED/CLOSED can go back to REOPENED → IN_PROGRESS)
  status           String    @default("NEW")
  resolution       String? // FIXED | WONT_FIX | DUPLICATE | CANNOT_REPRODUCE | WORKS_AS_INTENDED
  // People: reporter (QA) raised it; assignee (developer) works it.
  reporterUserId   String    @default("")
  assigneeUserId   String?
  // Optional links for traceability. `task` is the Task this bug belongs to
  // (Task ↔ Bug traceability — one bug links to at most one task; a task can
  // have many bugs). Deleting the task clears the link (SetNull). projectId
  // stays a plain column (resolved via bulk lookups, as before).
  projectId        String?
  taskId           String?
  task             Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  // Board enhancement — position of the card within its status column on
  // the bug board (same ordering mechanism as Task.order).
  boardOrder       Int       @default(0)
  // Environment where the bug was observed.
  environment      String    @default("") // e.g. "Production / Chrome 120 / macOS"
  // Timestamps for lifecycle metrics.
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  triagedAt        DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?

  comments BugComment[]

  @@index([status])
  @@index([severity])
  @@index([priority])
  @@index([reporterUserId])
  @@index([assigneeUserId])
  @@index([projectId])
  @@index([taskId])
  @@index([createdAt])
}

model BugComment {
  id         String   @id @default(cuid())
  bugId      String
  bug        Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  authorId   String   @default("")
  authorName String   @default("")
  body       String
  createdAt  DateTime @default(now())

  @@index([bugId])
  @@index([authorId])
}

// ---------------------------------------------------------------------------
// HR Module — leave management (feature 1 of docs/HR_MODULE_PLAN.md).
//
// Deliberately relation-light (plain string FKs, like CalendarEvent): the
// module resolves names/colors via bulk lookups, and NOT adding relations to
// User keeps the core model untouched. All types are SQLite-compatible so
// the sandbox preview (ADR-008) runs the same schema.
// ---------------------------------------------------------------------------

// A category of absence (Annual, Sick, Unpaid, ...). `code` is stable for
// programmatic reference; `color` drives the calendar chip; `requiresDoc`
// prompts for a document reference (e.g. medical certificate).
model LeaveType {
  id           String   @id @default(cuid())
  name         String   @unique
  code         String   @unique
  requiresDoc  Boolean  @default(false)
  paid         Boolean  @default(true)
  // P15 (PR-06) — fraction of daily salary paid per leave day, the
  // benchmark's partially-paid leave (fraction_of_daily_salary_per_leave).
  // Only meaningful on paid types; 1 (default) = fully paid = the pre-P15
  // semantics byte-for-byte; 0.5 = half paid (payroll docks (1 − fraction)
  // days per working day taken). Unpaid types charge the full working
  // fraction regardless (paid = false is fraction 0 by definition).
  salaryFraction Float  @default(1)
  // P30 (LV-01) — the benchmark's is_optional_leave: applications with this
  // type may land entirely on holidays/weekends (the range's working-day
  // count may be 0), and those days consume no balance — the optional
  // holiday is recorded and approved but never deducted (the request's
  // `days` stays 0). The per-year COUNT cap is the policy knob below.
  isOptionalLeave Boolean @default(false)
  // P30 (LV-01/LV-11) — the benchmark's is_compensatory: days arrive ONLY
  // through approved CompensatoryLeaveRequests (the worked-holiday claim
  // flow writes the ledger GRANT row); consumption is the normal request
  // path against those earned days. Usually paired with annualDays 0 (no
  // scheduled entitlement — the seed's Comp Off type shows the shape).
  isCompensatory Boolean  @default(false)
  color        String   @default("#8b5cf6")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  policy LeavePolicy?
}

// Entitlement + guard rails per leave type. One policy row per type
// (single-workspace deployment — the 1:1 lives in code, not a unique on a
// synthetic key, so the upsert path is deterministic).
model LeavePolicy {
  id                  String    @id @default(cuid())
  leaveTypeId         String    @unique
  leaveType           LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  // Full entitlement in working days per calendar year.
  annualDays          Float     @default(20)
  // Cap on unused days carried into the next year (balance math only —
  // carry-over itself is applied by the year-end rollover, not here).
  maxCarryOver        Float     @default(5)
  // A request must start at least this many working days from today.
  minNoticeDays       Int       @default(1)
  // Maximum consecutive working days one request may span.
  maxConsecutiveDays  Int       @default(15)
  // F2.4 — leave policy engine (docs/Fernly_Policy_Engine_Design.md §4.1;
  // docs/Fernly_HR_Payroll_Enhancement_Plan.md §7.2 F2.4). The allocation
  // strategy block: how entitlement becomes ledger GRANT rows, and the
  // guard knobs the request/approve floors read. Every default reproduces
  // the pre-F2.4 behavior exactly (MANUAL + no negative allowance + floor 0
  // + holidays excluded from counted days) — the migration is additive.
  // MANUAL            — grant-on-first-use (the pre-F2.4 materialization
  //                     path; nothing scheduled).
  // ANNUAL_LUMP_SUM   — the whole year at once (Jan 1 by default, or on the
  //                     hire anniversary; optional DOJ pro-rata).
  // EARNED            — accrual in periods (month/quarter/half/year), the
  //                     benchmark's "take advance leave, added monthly"
  //                     shape when combined with allowNegative.
  // AFTER_SERVICE     — the whole year deposited once the employee completes
  //                     minServiceMonths, repeating on that anniversary.
  allocationStrategy  String    @default("MANUAL") // MANUAL | ANNUAL_LUMP_SUM | EARNED | AFTER_SERVICE
  // EARNED cadence + the day of each period the GRANT lands
  // (DOJ_DAY = the hire day-of-month).
  accrualFrequency    String    @default("MONTHLY") // MONTHLY | QUARTERLY | HALF_YEARLY | ANNUAL
  allocateOnDay       String    @default("FIRST")   // FIRST | LAST | DOJ_DAY
  // Per-period grant rounding to 0.25-day steps (half-day semantics F1.1).
  accrualRounding     String    @default("FLOOR_QUARTER") // FLOOR_QUARTER | NEAREST
  // EARNED only: cap on the standing balance the strategy may build
  // (null = annualDays). Consumption frees room under a standing cap.
  accrualCap          Float?
  // ANNUAL_LUMP_SUM landing day: Jan 1 (PERIOD_START) or hire anniversary.
  grantOn             String    @default("PERIOD_START") // PERIOD_START | ANNIVERSARY
  // ANNUAL_LUMP_SUM + PERIOD_START: pro-rate by calendar days remaining in
  // the year for mid-year joiners (floor-quarter).
  prorateForJoiners   Boolean   @default(true)
  // AFTER_SERVICE: months of service before the first deposit. When > 0 it
  // is ALSO the LV-B07 usability gate (no leave before N months of service)
  // for every strategy.
  minServiceMonths    Int       @default(0)
  // EARNED/lump strategies: accrue while on probation (false defers grants
  // until probationEndsAt passes).
  accrueDuringProbation Boolean @default(true)
  // Advance (negative) leave: the guard becomes
  //   available − requested ≥ −negativeFloor
  // (identical to the classic guard when false / floor 0).
  allowNegative       Boolean   @default(false)
  negativeFloor       Float     @default(0)
  // Carried days lapse after N months of the new year (null = never) — the
  // year-end job writes the EXPIRE row once the lapse date passes.
  carryExpiresAfterMonths Int?
  // Holidays inside a request range consume leave days (LV-B01/B05's
  // include_holiday; default false = the F1.1 holiday-aware count).
  countHolidaysInLeave Boolean  @default(false)
  // P2 (LV-09, F2.2) — encashment knobs (the benchmark's allow_encashment /
  // max_encashable_days / non_encashable_days). Default false = zero
  // behavior change: no type sells days back until an admin opts in.
  encashable           Boolean  @default(false)
  // Max days ONE encashment request may take (0 = no per-request cap
  // beyond the balance floor).
  maxEncashableDays    Float    @default(5)
  // The balance floor that can never be encashed:
  // available − requested must stay ≥ this.
  nonEncashableDays    Float    @default(5)
  // P30 (LV-01) — the benchmark's "Max Days Leave Allowed" for optional
  // leave: how many optional-holiday applications one member may hold
  // (PENDING + APPROVED, this ledger bucket) per year. Null = no count cap
  // (the zero-change default — the type flag alone governs).
  maxOptionalHolidaysPerYear Int?
  updatedAt           DateTime  @updatedAt
}

// P27 (LV-08) — leave period master: NAMED allocation windows (the
// benchmark's `Leave Period` doctype). One row = one window (name, start,
// end; 1..370 days; validated non-overlapping, contiguous chain, one
// window per start calendar year). The window's LEDGER BUCKET is the
// calendar year of its start date — the integer `year` the ledger and
// LeaveBalance cache key on (src/lib/leave-period.ts, the pure rule).
// ZERO-CHANGE DEFAULT: the table starts EMPTY; with no rows every date
// falls to the implicit calendar-year window and every engine path is
// byte-identical to the pre-P27 behavior. A non-empty table stops implicit
// grants entirely (a half-migrated workspace must not double-grant);
// requests during uncovered dates spend against the latest closed window.
model LeavePeriod {
  id        String   @id @default(cuid())
  name      String   @unique
  // Inclusive first/last day of the window (UTC-midnight date-only, the
  // LeaveRequest convention).
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// P28 (LV-02) — leave policy set master: the benchmark's multi-type
// allocation template (`Leave Policy` + `Leave Policy Detail`). One row per
// set; the ITEMS (below) carry one allocation per leave type — the
// benchmark's own child shape (leave_type + annual_allocation, nothing
// more; every other knob stays on the per-type LeavePolicy row, exactly as
// the benchmark keeps them on the Leave Type). ZERO-CHANGE DEFAULT: the
// table starts EMPTY; with no sets and no assignments every materializer
// resolves the pre-P28 per-type policy byte-identically (the override is
// undefined → the row passes through).
model LeavePolicySet {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  // Retiring a set hides it from the assign picker only — existing
  // assignments keep resolving (the assignment row is the live doc).
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// One set row: the type's annual allocation inside THIS set (working days
// per allocation window). Plain-string FKs (the LeaveLedgerEntry
// convention — referential guards live in the actions; leave types are
// soft-deactivated, never hard-deleted).
model LeavePolicySetItem {
  id          String   @id @default(cuid())
  setId       String
  leaveTypeId String
  annualDays  Float    @default(20)
  createdAt   DateTime @default(now())

  @@unique([setId, leaveTypeId])
  @@index([setId])
}

// P28 (LV-03) — the assignment doc: ONE set governing ONE employee's
// entitlement for ONE ledger bucket (the benchmark's `Leave Policy
// Assignment` — employee × leave period, overlap-forbidden). The unique
// (userId, bucketYear) IS the overlap rule; reassigning a granted bucket is
// refused in the action (history is immutable — the P27 delete discipline).
// periodId is the named period's id when the bucket maps to one, "" for the
// implicit calendar year. The engine reads the assignment as a row-level
// annualDays override on the type's own policy row (lib/leave-policy-set.ts
// — policyRowWithAnnualDays): every strategy flows through the SAME F2.4
// kernel with the set's number.
model LeavePolicyAssignment {
  id           String   @id @default(cuid())
  userId       String
  setId        String
  // The ledger bucket this assignment governs (the target window's bucket).
  bucketYear   Int
  // The named LeavePeriod row backing the bucket, "" when implicit.
  periodId     String   @default("")
  assignedAt   DateTime @default(now())
  assignedById String

  @@unique([userId, bucketYear])
  @@index([setId])
  @@index([bucketYear])
}

// P2 (LV-09, F2.2) — one encashment request: days sold back from a leave
// balance, paying through the P1 PayAdjustment adapter. The member requests
// (against the LEDGER projection), the leave-approver chain decides
// (assertLeaveDecider — same decider as time-off), approval writes the
// CONSUME ledger row + the ENCASHMENT adjustment in ONE transaction, and
// the consuming run's lock flips the row PAID (paidRunId back-link).
model LeaveEncashment {
  id          String    @id @default(cuid())
  userId      String
  leaveTypeId String
  // The ledger year the request validated against (the CONSUME row lands
  // in this year — the year the days were actually held).
  year        Int
  // Days sold (quarter-day steps like every leave fraction).
  days        Float
  // PENDING → APPROVED | REJECTED; APPROVED → PAID (on the consuming
  // run's lock, via the adapter row's consumedRunId).
  status      String    @default("PENDING")
  // The payout period ("YYYY-MM") the money rides — must not be a LOCKED
  // run at request AND approval time.
  payoutPeriod String
  // Amount snapshots at approval (days × dailyRate — the daily rate of the
  // payout period's working days, F2.1's GROSS_OVER_WORKING_DAYS basis).
  amount      Float     @default(0)
  dailyRate   Float     @default(0)
  reason      String    @default("")
  createdById String    @default("")
  decidedById String?
  decidedAt   DateTime?
  decisionNote String   @default("")
  paidRunId   String    @default("")
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status])
  @@index([status])
}

// P30 (LV-01/LV-11, the benchmark's `Compensatory Leave Request`) — the
// worked-holiday claim: a member files the non-working day(s) they worked
// (workFrom..workTo, EVERY day must be a weekend/holiday-calendar day), HR
// validates attendance shows they actually worked (PRESENT/WFH = 1 day,
// HALF_DAY = 0.5), and APPROVAL appends the comp GRANT ledger row (+days,
// sourceType COMP_REQUEST) in the same transaction as the status flip —
// the days then spend through the normal LeaveRequest path against the
// compensatory type. REJECTED claims nothing. Plain-string FKs (the
// LeaveRequest convention): ledger rows outlive their sources.
model CompensatoryLeaveRequest {
  id          String   @id @default(cuid())
  userId      String
  // Must reference an active LeaveType with isCompensatory = true.
  leaveTypeId String
  // The worked span (UTC-midnight date-only, the LeaveRequest convention).
  workFromDate DateTime
  workToDate   DateTime
  // Derived at creation from the day walk (kernel: earnedCompDays) —
  // never re-derived; the number the GRANT row will write.
  days        Float
  reason      String   @default("")
  // PENDING → APPROVED | REJECTED (guarded flips only).
  status      String   @default("PENDING")
  decidedById String?
  decidedAt   DateTime?
  decisionNote String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status])
  @@index([status])
  @@index([workFromDate, workToDate])
}

// A member's time-off request. `days` is denormalized at creation from the
// working-day count (Mon-Fri) between startDate and endDate inclusive —
// the balance arithmetic never re-derives it, so the number on the request
// always matches what was actually deducted.
model LeaveRequest {
  id           String    @id @default(cuid())
  leaveTypeId  String
  userId       String
  startDate    DateTime
  endDate      DateTime
  days         Float
  reason       String    @default("")
  // PENDING → APPROVED | REJECTED; PENDING/APPROVED → CANCELLED.
  status       String    @default("PENDING")
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([userId])
  @@index([leaveTypeId])
  @@index([startDate])
  @@index([createdAt])
}

// Per-user, per-type, per-year balance. `used` counts APPROVED days only and
// is mutated exclusively inside approve/cancel (transactional) so the
// invariant used == sum(days of non-cancelled APPROVED requests) holds.
model LeaveBalance {
  id          String   @id @default(cuid())
  userId      String
  leaveTypeId String
  year        Int
  entitled    Float    @default(0)
  carriedOver Float    @default(0)
  used        Float    @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([userId, leaveTypeId, year])
  @@index([userId])
}

// F1.2 — append-only leave ledger (docs/Fernly_HR_Payroll_Enhancement_Plan.md
// §7.1, benchmark: frappe/hrms Leave Ledger Entry). THE source of truth for
// every balance mutation; LeaveBalance above is a derived cache that is
// re-synced from the ledger aggregate inside the same transaction as every
// ledger write, so the two can never disagree for longer than one mutation.
//
// Semantics (signed `delta`, all rows immutable — corrections are new
// reversal rows, never edits or deletes):
//   • GRANT   +entitlement when a LeaveBalance row is materialized from the
//     policy default (the year-start grant; earned-leave accrual in F2.4
//     will add monthly GRANT rows).
//   • CARRY   +carry-over at year rollover (F2.4 writer; reserved here so
//     the projection already understands it).
//   • CONSUME −days on approval; +days with isReversal=true when an
//     approved request is cancelled (the undo of that consumption).
//   • EXPIRE  −days at year end for balances above maxCarryOver (F2.4).
//   • ADJUST  ±manual/drift reconciliation (e.g. the F1.2 backfill trues
//     legacy `used` against APPROVED-request days).
//
// Invariants (pinned in src/lib/__tests__/leave-ledger.test.ts and the
// hr-leave action tests):
//   LeaveBalance.used       == -Σ(delta of CONSUME)   [reversals included]
//   LeaveBalance.entitled   ==  Σ(delta of GRANT)
//   LeaveBalance.carriedOver==  Σ(delta of CARRY)
//   available (any guard)   ==  Σ(delta of ALL rows)  — one aggregate query
//
// sourceType/sourceId is a polymorphic pointer (LEAVE_REQUEST, POLICY,
// BALANCE_IMPORT, …) — deliberately NOT a FK, mirroring LeaveRequest's
// plain-string references: ledger rows outlive their sources (a cancelled
// request's rows must survive to tell the story).
model LeaveLedgerEntry {
  id          String   @id @default(cuid())
  userId      String
  leaveTypeId String
  year        Int
  // Signed day delta: positive grants/carry/reversals, negative
  // consumption/expiry. Float, not Int — half-day semantics (F1.1) make
  // 0.5-day consumption a first-class value.
  delta       Float
  // GRANT | CARRY | CONSUME | EXPIRE | ADJUST — see the block comment above.
  entryType   String
  // LEAVE_REQUEST | POLICY | BALANCE_IMPORT | MIGRATION — what wrote the row.
  sourceType  String   @default("")
  // Id of the row sourceType points at ("" when sourceless).
  sourceId    String   @default("")
  note        String   @default("")
  // True on a row that undoes a prior row (cancel-of-approval). The
  // benchmark's is_reversal discipline: the pair is self-describing.
  isReversal  Boolean  @default(false)
  // P29 (LV-04) — the day this row's days lapse, frozen at write time.
  // Set ONLY on CARRY rows (the benchmark's per-row CF expiry: the new-year
  // allocation document writes its new + CF parts each with its own expiry
  // date). Null = never lapses — including pre-P29 rows, which the lapse
  // phase bridges with the policy's CURRENT carryExpiresAfterMonths clock
  // (the pre-P29 aggregate rule, byte-identical).
  expiryAt    DateTime?
  createdAt   DateTime @default(now())

  @@index([userId, leaveTypeId, year])
  @@index([sourceType, sourceId])
  @@index([createdAt])
}

// F1.1 — workspace holiday calendar (docs/Fernly_HR_Payroll_Enhancement_Plan.md
// §7.1). One row per date (unique): any entry removes that date from
// working-day counting (isHalfDay counts it as 0.5). `kind` is labeling —
// PUBLIC (statutory/national holiday) vs WEEKLY_OFF (a scheduled non-working
// day such as a company off-day); both are excluded from the count. Dates are
// UTC-midnight date-only values (LeaveRequest.startDate convention). Seeded
// with NZ public holidays for the demo workspace (Pacific/Auckland).
model HolidayCalendarEntry {
  id        String   @id @default(cuid())
  date      DateTime @unique
  label     String   @default("")
  isHalfDay Boolean  @default(false)
  kind      String   @default("PUBLIC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
}

// F1.3 — attendance records (docs/Fernly_HR_Payroll_Enhancement_Plan.md
// §7.1). One row per user per date (unique userId+date): HR/admin marks
// PRESENT / ABSENT / HALF_DAY / WFH at the attendance:manage permission
// (ADMIN+HR — a NEW permission, deliberately not hr:admin, so a DB
// permission ceiling can diverge the two); approved leave derives ON_LEAVE
// rows (source DERIVED — ADR-009 virtual-event precedent). No member
// self-marking (decision §9.1): WFH is a status HR sets, never a member
// self-request; card scanning is a future phase. inTime/outTime are
// optional "HH:mm" clock strings. Dates are UTC-midnight date-only values
// (LeaveRequest.startDate convention).
model AttendanceRecord {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  status    String   @default("PRESENT")
  inTime    String?
  outTime   String?
  // AT-B02/B03 (S2) — derived timing facts, computed by the pure
  // lib/attendance-flags.ts kernel against the workspace default day at
  // WRITE time (derived-statuses discipline: never a form input, never
  // hand-edited; editing in/out recomputes). null = not computable (the
  // dependent time is absent). A config change does not retro-rewrite —
  // rows keep the facts they were marked with (F1.1 denormalization
  // discipline). Shifts arrive in F3.5 and will replace the reference.
  lateMinutes  Int?
  earlyMinutes Int?
  workingHours Float?
  // P9 (PR-B26/AT-09 lite) — minutes worked beyond the workspace day end,
  // same S2 discipline. The payroll bridge (lib/overtime-bridge.ts) sums
  // these per period into an Overtime earning line when the workspace
  // overtime payout knob is on; shift-based multipliers arrive with F3.5.
  overtimeMinutes Int?
  note      String   @default("")
  source    String   @default("MANUAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([status])
}

// F1.5 — salary component catalog (docs/Fernly_HR_Payroll_Enhancement_Plan.md
// §7.1; benchmark: frappe/hrms Salary Component). Master data behind the
// structure editor's "add from catalog" picker: the curated definitions of
// every component the workspace pays. `code` is the stable identity and maps
// 1:1 onto OfferComponent.key — structures keep their OWN copies of each
// line (snapshot discipline, same as offers vs offer templates), so editing
// or retiring a catalog row never rewrites history: it only changes what the
// picker offers next time. defaultAmount is a SUGGESTION by mode (mirrors
// OfferComponent.amount's dual meaning): FIXED → suggested annual amount;
// PERCENT_OF_BASIC → percent of the basic anchor. createStructureFromOffer
// maps offer lines through the catalog (canonical label/kind/mode per code,
// auto-registering codes it has never seen) so the catalog converges on
// everything actually in use. CRUD rides payroll:manage (ADMIN+HR) — salary
// vocabulary is as sensitive as salary itself.
model SalaryComponent {
  id            String   @id @default(cuid())
  code          String   @unique
  label         String
  kind          String   @default("EARNING") // EARNING | EMPLOYER_CONTRIBUTION | DEDUCTION | STATISTICAL (S8: display-only, never money)
  mode          String   @default("FIXED")   // FIXED | PERCENT_OF_BASIC
  defaultAmount Float    @default(0)
  // PR-B02 (S6) — depends_on_payment_days: true (default) = payslip lines
  // from this component scale with the employment-window paid days and are
  // docked by loss-of-pay; false = window-exempt flat line. The catalog row
  // owns the knob; structures/payslips snapshot copies per line (sparse:
  // only false is stored in the JSON).
  dependsOnPaymentDays Boolean @default(true)
  // P16 (PR-11's component effective windows) — optional validity window
  // on the catalog row (the benchmark's Payroll Period Date component
  // start/end dates, Fernly-shaped on the master instead of the
  // assignment). Null = unbounded (the default = pre-P16). The structure
  // editor badges rows whose window doesn't cover the structure's
  // effectiveFrom and saveSalaryStructure refuses them (friendly error);
  // structures themselves keep snapshot copies, so editing a window never
  // rewrites history.
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  // --- Phase 3 (Task 3.3) — the statutory tax mapping. The payroll run
  // (Phase 2 wiring) consults these to decide which structure lines feed
  // the engine's gross; the super-admin component-mapping editor owns
  // them. ---
  // Does money from this component count as taxable income?
  taxApplicable     Boolean @default(true)
  // How the statutory engine classifies the line:
  //   TAXABLE_EARNING | NON_TAXABLE | PRE_TAX_DEDUCTION |
  //   POST_TAX_DEDUCTION | EMPLOYER_CONTRIBUTION | STATISTICAL
  statutoryCategory String  @default("TAXABLE_EARNING")
  // The statutory wage base the component feeds: GROSS (the engine's
  // taxable gross — PAYE / ACC levy / student loan / KiwiSaver base) or
  // NONE (excluded from every wage base: reimbursements, employer lines,
  // deductions, statistical rows).
  wageBaseRef       String  @default("GROSS")
  // True = a system-seeded row (the demo catalog / future engine-internal
  // components). Read-only in the mapping editor — the engine or the seed
  // owns it, not the workspace admin.
  isSystemGenerated Boolean @default(false)
  // Phase 1C (G2) — the GL posting map: which EXPENSE account debits this
  // component's earning lines (null = the system 4000 Salaries & Wages
  // fallback) and which LIABILITY account credits its deduction lines
  // (null = the 4000 expense-reduction fallback for non-statutory
  // deductions). Both null = the safe pre-1C default.
  expenseAccountId   String?
  liabilityAccountId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

// HR Module feature 2 — employee directory (docs/HR_MODULE_PLAN.md §5).
// One row per user (userId unique): structured job + contact data. The
// manager display comes from the existing User.managerId org chart — this
// table adds NO manager field, avoiding a second source of truth.
model EmployeeProfile {
  // EM-B01 (S13) — the workspace employee-number series (EMP-0001…).
  // Assigned at creation through the ONE nextEmployeeNumber helper
  // (hr-shared) inside the creating transaction; unique; the migration
  // backfills existing profiles deterministically by (createdAt, id).
  // Nullable only so pre-S13 rows and exotic integrations stay legal.
  employeeNumber String? @unique
  // EM-B04/LV-B13 (S14) — the leave-approver override: when set, THIS user
  // decides the employee's leave requests (and is notified) instead of the
  // reporting manager. Null = the manager chain decides (today's rule).
  // Scalar (no FK relation) like the profile's other references — the
  // resolver validates the target at write time.
  leaveApproverId String?
  id                   String    @id @default(cuid())
  userId               String    @unique
  jobTitle             String    @default("")
  // QA-19: "" = not classified yet (rendered as "—"). Self-created and
  // admin-created profiles without a picked department must not fabricate
  // the old "ENGINEERING" default into the shared roster.
  department           String    @default("") // mirrors Department union in lib/types
  hireDate             DateTime?
  phone                String    @default("")
  location             String    @default("")
  emergencyContactName String    @default("")
  emergencyContactPhone String   @default("")
  skills               String    @default("") // free-text, comma-separated
  notes                String    @default("") // HR-visibility notes
  // F1.6 — employment lifecycle (docs/Fernly_HR_Payroll_Enhancement_Plan.md
  // §7.1). QA-19 discipline: "" = not tracked yet (rendered as "—") —
  // self-created profiles carry no HR-asserted employment fact. Status is
  // ONLY written by the guarded transitionEmployment action (the §9.3 hard
  // gate lives there), never by the plain profile-edit path.
  employmentStatus     String    @default("") // "" | PROBATION | ACTIVE | SUSPENDED | EXITED (lib/employment.ts)
  probationEndsAt      DateTime?
  noticePeriodWeeks    Int?
  lastWorkingDay       DateTime?
  // P25 (PL-02/EM-J01) — the birthday reminder engine's input. Nullable
  // and date-only semantics (stored at UTC midnight): a member may omit it
  // entirely (privacy-friendly — no birthday, no reminder), and the year
  // is HONEST data (the engine only ever compares month+day; the roster
  // never displays the year). HR-owned like hireDate, never self-service.
  birthDate            DateTime?
  // P34 (EM-03) — the employee grouping axes: grade, employment type and
  // branch (the benchmark's Employee master slicing facts). QA-19 style:
  // "" = not classified yet (rendered as "—"), never a fabricated default.
  // HR-owned like jobTitle/department (the self-service schema rejects
  // them — QA-10); grade is a free-form ladder string (the Employee Grade
  // MASTER, EM-09, stays a later epic — this is the field), employmentType
  // is a controlled vocabulary (lib/config EMPLOYMENT_TYPE_LABELS:
  // FULL_TIME / PART_TIME / CONTRACT / INTERN / CONSULTANT) validated at
  // the zod boundary, branch is a plain string (workspaces name their own
  // offices — no master by design, the plan entry says "a plain branch
  // string"). Grade is promotable: the P33 property-history registry
  // registers it at P34 as planned (lib/employment-change.ts).
  grade                String   @default("")
  employmentType       String   @default("")
  branch               String   @default("")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([department])
  @@index([employmentStatus])
  @@index([employmentType])
}

// P33 (EM-06) — the structured property history (the benchmark's
// Employee Property History child): ONE row per changed employment
// property, written ONLY by the guarded applyEmploymentChange action
// inside its transaction (the promotion/transfer writer), carrying the
// property key, the display value before and after, the effective date
// and the change's kind. The generic AuditLog stays the free-form
// record; THIS table is the machine-readable diff the promotion/transfer
// actions and the directory's history panel read. Grade joined the
// property set when EM-03 (P34) landed the field.
model EmployeePropertyHistory {
  id           String   @id @default(cuid())
  userId       String
  // jobTitle | department | grade | manager | location | salary (the
  // promotable property registry lives in lib/employment-change.ts; location
  // joined at P1 G6 when transfers started carrying it).
  property     String
  // Display value BEFORE the change (label/manager-name/gross rendered).
  currentValue String
  // Display value AFTER the change.
  newValue     String
  // The change's effective date (date-only semantics, UTC midnight).
  effectiveAt  DateTime
  // PROMOTION | TRANSFER (the writer's kind).
  sourceKind   String    @default("PROMOTION")
  createdById  String    @default("")
  createdAt    DateTime  @default(now())

  @@index([userId, effectiveAt])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// P1 G6 — the Employee Transfer document: an effective-dated, approval-gated
// move across the employment axes (department / job title / reporting
// manager / location). Fernly stores those facts as strings on
// EmployeeProfile (QA-19 discipline: the department is a controlled key, the
// title and location are free strings; there is intentionally NO Department
// or Designation master table), so the from/to sides carry the same string
// shape instead of FK ids. The from-side is SNAPSHOTTED at creation; the
// to-side is the requested end state. Status graph (spec §2):
//   DRAFT → PENDING_APPROVAL (HR/Admin submits; future effective date)
//   PENDING_APPROVAL → APPROVED (a different pair of eyes approves)
//   APPROVED → EFFECTIVE (on/after the effective date — the daily sweep or
//   a manual admin trigger; the ONLY state that writes profile facts)
//   any pre-EFFECTIVE state → CANCELLED (the creator, or an ADMIN as the
//   safety valve for an orphaned APPROVED doc)
// The graph itself lives in lib/hr/employment-documents.ts. Manager refs are
// plain scalars (the EmployeeProfile.leaveApproverId convention — validated
// at write time, no FK): the org chart moves, the document must not.
// ---------------------------------------------------------------------------
model EmployeeTransfer {
  id         String   @id @default(cuid())
  employeeId String
  employee   User     @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  // The from-side snapshot (the live facts at DRAFT time; null = not tracked).
  fromDepartment String?
  fromJobTitle   String?
  fromManagerId  String?
  fromLocation   String?
  // The requested end state. At least one axis must actually change (the
  // writer refuses a no-change transfer; same department/title is refused
  // outright per spec §4).
  toDepartment String?
  toJobTitle   String?
  toManagerId  String? // null = clear the reporting line (move to root)
  toLocation   String?

  effectiveDate DateTime
  reason        String?

  status        String   @default("DRAFT") // the graph: lib/hr/employment-documents.ts
  approvedById  String?
  approvedAt    DateTime?
  cancelledById String?
  cancelledAt   DateTime?

  createdAt   DateTime @default(now())
  createdById String

  @@index([employeeId, status])
  @@index([employeeId, effectiveDate])
  @@index([status, effectiveDate])
}

// ---------------------------------------------------------------------------
// P1 G6 — the Employee Promotion document: an effective-dated, approval-gated
// designation (and optionally grade) change. Same string-shape rationale and
// the same status graph as EmployeeTransfer. toJobTitle is REQUIRED and must
// differ from the from-side (spec §4: "cannot promote to the same
// designation"); toGrade is optional but, when present, must differ. The
// optional linkedSalaryAssignmentId points at a Phase 1B
// SalaryStructureAssignment (plain scalar by design — the promotion document
// NEVER mutates the assignment; the salary revision is its own document, and
// the link only records that the two belong together).
// ---------------------------------------------------------------------------
model EmployeePromotion {
  id         String   @id @default(cuid())
  employeeId String
  employee   User     @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  fromJobTitle String?
  toJobTitle   String
  fromGrade    String?
  toGrade      String?

  effectiveDate DateTime
  reason        String?
  status        String   @default("DRAFT") // the graph: lib/hr/employment-documents.ts
  approvedById  String?
  approvedAt    DateTime?
  cancelledById String?
  cancelledAt   DateTime?
  linkedSalaryAssignmentId String?

  createdAt   DateTime @default(now())
  createdById String

  @@index([employeeId, status])
  @@index([employeeId, effectiveDate])
  @@index([status, effectiveDate])
}

// HR Module feature 3 — performance reviews (docs/HR_MODULE_PLAN.md §6).
// Self + manager model: the employee writes a self-assessment (DRAFT),
// submits it (SUBMITTED), their manager reviews + rates (REVIEWED), and the
// employee acknowledges the result (ACKNOWLEDGED). Ratings are 1–5.
// F1.6 — kind separates ordinary cycles from PROBATION reviews; the §9.3
// hard gate (PROBATION → ACTIVE) is satisfied only by a PROBATION-kind
// review that reached REVIEWED/ACKNOWLEDGED.
model PerformanceReview {
  id               String    @id @default(cuid())
  userId           String
  title            String
  kind             String    @default("STANDARD") // STANDARD | PROBATION (lib/employment.ts)
  periodStart      DateTime
  periodEnd        DateTime
  // DRAFT → SUBMITTED → REVIEWED → ACKNOWLEDGED (terminal).
  status           String    @default("DRAFT")
  selfAssessment   String    @default("")
  selfRating       Int?
  managerComment   String    @default("")
  managerRating    Int?
  reviewedById     String?
  reviewedAt       DateTime?
  acknowledgedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// HR Module feature 4 — onboarding (docs/HR_MODULE_PLAN.md §7).
// A checklist is instantiated per new hire from a default template; each
// task has an assignee (a User) and a due offset from the hire date. The
// checklist auto-completes when every task is done.
// F2.1 — the same machinery carries SEPARATION checklists: `kind` splits
// the onboarding (new hire) flow from the offboarding (exit) flow while
// tasks, auto-completion, tick permissions and the manager auto-assignment
// stay one code path. `newHireId` reads as "the user the checklist is
// about" for separation rows (docs/Fernly_HR_Payroll_Enhancement_Plan.md
// §7.2 F2.1; benchmark EM-14).
model OnboardingChecklist {
  id          String    @id @default(cuid())
  newHireId   String
  title       String
  // ONBOARDING (new hire) | SEPARATION (exit) — picks the default template
  // and which console tab owns the row. Default keeps every pre-F2.1 row
  // on the onboarding side (zero-behavior rollout).
  kind        String    @default("ONBOARDING")
  // Derived: when every task is done, the checklist is complete.
  completedAt DateTime?
  // P35 (EM-12) — the day the checklist's clock started: the working-day
  // walk anchor for every task's dueDate (profile hireDate / lastWorkingDay,
  // HR-pinnable at creation). Nullable = a pre-P35 row (due dates read as
  // "not yet dated" — never a fabricated today).
  startDate   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks OnboardingTask[]

  @@index([newHireId])
  @@index([createdAt])
  @@index([kind])
}

model OnboardingTask {
  id           String   @id @default(cuid())
  checklistId  String
  checklist    OnboardingChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  title        String
  // The User responsible for ticking this task (HR, the hire's manager,
  // or the hire themself).
  assigneeId   String?
  // P35 (EM-B06) — non-empty = a ROLE-scoped task: every holder of this
  // role key (ADMIN/MANAGER/HR/MEMBER) sees the task and may tick it;
  // assigneeId stays NULL. "" = the historical single-user discipline.
  assigneeRole String   @default("")
  // Days after the checklist start the task is due by.
  dueOffsetDays Int     @default(7)
  // P35 (EM-12) — the holiday-aware due date: startDate advanced
  // dueOffsetDays WORKING days (weekends + full holiday-calendar entries
  // skipped; half-day holidays count). Null = pre-P35 row / undated.
  dueDate      DateTime?
  // P35 (EM-12) — required tasks render flagged (the benchmark's
  // required_for_employee_creation flag, carried per row).
  isRequired   Boolean  @default(false)
  done         Boolean  @default(false)
  doneAt       DateTime?
  doneById     String?
  notes        String   @default("")
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([checklistId])
  @@index([assigneeId])
}

// F2.10 (F-R8) — the ONE onboarding template source. Before this table the
// five-task template lived as THREE copies in code (hr-onboarding.ts's
// DEFAULT_TEMPLATE, an inline copy inside markJoined that had already
// drifted — its manager tasks were never auto-assigned — and a client copy
// in joiner-handout.tsx). Rows are configurable (onboarding:manage CRUD);
// an empty table falls back to the canonical constants
// (lib/onboarding-template.ts) so a fresh install is never template-less.
model OnboardingTemplateTask {
  id            String   @id @default(cuid())
  // ONBOARDING | SEPARATION — which default template the row belongs to.
  kind          String   @default("ONBOARDING")
  title         String
  // Days after the checklist starts the task is due by.
  dueOffsetDays Int      @default(7)
  // true = the new hire / exiting employee ticks it themself; false = the
  // hire's manager (or HR when no manager is set) owns it.
  assignSelf    Boolean  @default(false)
  // P35 (EM-B06) — user XOR role assignee, overriding the self/manager
  // discipline above: assigneeUserId pins ONE user (the instantiated task
  // lands on them); assigneeRole scopes the task to a role KEY (every
  // holder sees and can tick it). Exactly one may be set (zod-enforced);
  // both empty = the assignSelf rule keeps applying.
  assigneeUserId String?
  assigneeRole   String   @default("")
  // P35 (EM-12) — required_for_employee_creation: rides the
  // instantiation onto the task row (flagged in the UI).
  isRequired    Boolean  @default(false)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([kind])
  @@index([sortOrder])
}

// F2.1 — exit interview (docs/Fernly_HR_Payroll_Enhancement_Plan.md §7.2;
// benchmark EM-15: frappe/hrms Exit Interview). One LIVE record per
// employee: the action layer enforces "at most one non-cancelled row per
// user" (CANCELLED rows stay as history, so a mistaken cancel never bricks
// the employee — the benchmark's one-per-employee rule applied to live
// records only). Status machine:
//   PENDING → SCHEDULED → COMPLETED            (terminal)
//   PENDING | SCHEDULED → CANCELLED            (terminal)
// Scheduling notifies the employee in-app (EM-T01 lite — the HR module's
// zero-mail-side-effects discipline F-R17 keeps this off the email path).
model ExitInterview {
  id            String    @id @default(cuid())
  userId        String
  // PENDING | SCHEDULED | COMPLETED | CANCELLED (lib/full-and-final.ts
  // vocabulary lives beside the FnF kinds — one offboarding module file).
  status        String    @default("PENDING")
  // Set when SCHEDULED (rescheduling while SCHEDULED updates it).
  scheduledAt   DateTime?
  // The user conducting the interview (optional — HR may leave it open).
  interviewerId String?
  // Free-text notes; completed with the outcome summary.
  notes         String    @default("")
  completedAt   DateTime?
  createdById   String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// F2.1 — full-and-final statement (docs/Fernly_HR_Payroll_Enhancement_Plan.md
// §7.2; benchmark EM-16, deliberately LITE). One row per employee (unique —
// settlement is final; corrections are F3.x statement-revision work, never
// edits). Two states:
//   UNSETTLED — generated, still COMPUTED LIVE on every read (the row holds
//               only the generation-time snapshot for the audit trail);
//   SETTLED   — the live computation was frozen into lines/totals at settle
//               time; payslip edits for the employee are refused from then
//               on ("settlement locks editing").
// Payables: unprocessed salary (OPEN runs' payslip nets — a LOCKED run was
// paid, so it is not owed) + unused-leave encashment (paid types, positive
// ledger balances × daily rate = monthly gross ÷ working days, the F2.2
// default basis GROSS_OVER_WORKING_DAYS until F2.2's knobs land).
// Receivables: advance (negative) leave balances recovered at the daily
// rate — the F2.4 advance-leave exit dock (Fernly_Policy_Engine_Design.md
// §5.2/§5.5). Bonuses (F2.3) and advances/loans (F2.8) extend the line set
// when those epics land.
model FullAndFinalStatement {
  id               String    @id @default(cuid())
  userId           String    @unique
  // UNSETTLED | SETTLED.
  status           String    @default("UNSETTLED")
  // The exit basis snapshot at generation (the transition guard guarantees
  // an EXITED employee always carries a lastWorkingDay).
  lastWorkingDay   DateTime?
  // When the stored snapshot was computed (generation or settlement).
  asOf             DateTime?
  // JSON FnFLineT[] — the generation preview while UNSETTLED, the frozen
  // settlement lines once SETTLED (lib/types).
  lines            String    @default("[]")
  payableTotal     Float     @default(0)
  receivableTotal  Float     @default(0)
  netPayable       Float     @default(0)
  generatedById    String    @default("")
  settledById      String    @default("")
  settledAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
}

// ---------------------------------------------------------------------------
// Recruitment module (docs/RECRUITMENT_MODULE_PLAN.md).
//
// Same philosophy as the HR models above: relation-light (plain string FKs to
// User), SQLite-compatible types, names resolved via bulk lookups. The only
// relation is Candidate → CandidateStage (cascade), because a stage instance
// has no meaning without its candidate.
//
// Configurability contract (user decision 2026-11-04): the workspace stage
// TEMPLATE (HiringStageConfig) is fully editable — add/rename/reorder/retype
// stages per company. Every candidate SNAPSHOTS the template at creation time
// (CandidateStage.label/stageType are copies), so template edits never rewrite
// a candidate's history; per-candidate override = SKIPPED stages or extra
// custom stages added to one person.
// ---------------------------------------------------------------------------

// A stage in the workspace's hiring pipeline template. ownerRole is the
// DEFAULT owner (display hint; concrete per-candidate owner is
// CandidateStage.ownerUserId — e.g. the assigned interviewer).
// ---------------------------------------------------------------------------
// P37 (EM-19, PF-07, EM-18) — the skill master + employee skill maps.
//
// The benchmark's Skill master is SHARED between employee skill maps and
// interview Expected Skill Sets (the round-template epic rides the same
// master). Rows are referenced by KEY so label renames never orphan
// history — the DocumentTypeConfig discipline.
// ---------------------------------------------------------------------------
model Skill {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String   @default("")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

// P37 (EM-18) — one RATED skill per employee (the structured record HR
// curates; the free-text profile `skills` string stays as the quick
// self-service summary). rating 1–5; proficiency labels derive at read.
model EmployeeSkill {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("EmployeeSkillMap", fields: [userId], references: [id], onDelete: Cascade)
  // Skill.key — stable identifier; label is a snapshot.
  skillKey     String
  label        String
  // 1–5 (validated at the zod boundary; default 3 = "solid").
  rating       Int       @default(3)
  notes        String    @default("")
  assessedById String    @default("")
  assessedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, skillKey])
  @@index([userId])
  @@index([skillKey])
}

model HiringStageConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  // SCREENING | INTERVIEW | ASSESSMENT | BG_CHECK | DOCUMENTS | OFFER | CUSTOM
  stageType   String   @default("CUSTOM")
  // HR | MANAGER | ADMIN — who drives this stage by default.
  ownerRole   String   @default("HR")
  description String   @default("")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// A person moving through the pipeline. Email is unique — one pipeline record
// per person (re-applicants are handled by reopening, not duplicating).
// status: ACTIVE → SELECTED (offer stage) → HIRED | REJECTED | WITHDRAWN
// (SELECTED is the joining-formalities gate F2.10 reads). userId is set when the
// candidate joins and their employee account is created (R6).
model Candidate {
  id           String    @id @default(cuid())
  fullName     String
  email        String    @unique
  phone        String    @default("")
  // Free-text job title applied for (e.g. "Senior Frontend Engineer").
  position     String    @default("")
  // DepartmentConfig key (ENGINEERING | DESIGN | ...) — "" = unclassified.
  department   String    @default("")
  // Where the applicant came from: referral / job board / website / agency…
  source       String    @default("")
  resumeUrl    String    @default("")
  notes        String    @default("")
  status       String    @default("ACTIVE")
  // Required when status = REJECTED (validation-enforced) — the reason is also
  // merged into the rejection email (R3).
  rejectReason String    @default("")
  decidedAt    DateTime?
  decidedById  String?
  createdById  String    @default("")
  userId       String?
  joinedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  stages CandidateStage[]
  outbox MailOutbox[]
  documents CandidateDocument[]
  bgChecks BackgroundCheck[]
  offers OfferRecord[]

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

// One instantiated stage on one candidate. label/stageType are SNAPSHOTS of
// the template at candidate-creation time. status: PENDING → IN_PROGRESS →
// PASSED | FAILED, plus SKIPPED (per-candidate override). rating is the 1–5
// scorecard score (R2 interview scorecards; validated 1..5 when present).
//
// R2 — interview scheduling + scorecards: eventId links the calendar event
// created when the interview is scheduled; strengths/concerns/recommendation
// are the structured scorecard (recommendation: STRONG_HIRE | HIRE | NO_HIRE).
model CandidateStage {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  // Template key snapshotted — unique per candidate so a stage can exist once.
  stageKey    String
  label       String
  stageType   String    @default("CUSTOM")
  // Concrete owner (e.g. the assigned interviewer); null = the default owner
  // role from the template drives it.
  ownerUserId String?
  status      String    @default("PENDING")
  scheduledAt DateTime?
  remarks     String    @default("")
  rating      Int?
  // R2 scorecard (docs/RECRUITMENT_MODULE_PLAN.md §5, research D: structured
  // 1–5 scale + strengths/concerns + a hire recommendation).
  strengths   String    @default("")
  concerns    String    @default("")
  recommendation String?
  // CalendarEvent.id when this interview stage has been scheduled (R2).
  eventId     String?
  sortOrder   Int       @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([candidateId, stageKey])
  @@index([candidateId])
  @@index([ownerUserId])
  @@index([status])
}

// R3 — auditable outbox for every candidate-facing email. A row is written
// BEFORE the send attempt (status QUEUED), then resolved to SENT (provider
// accepted; providerMessageId set), SKIPPED (no provider configured — dev
// dry-run / RESEND_API_KEY unset), or FAILED (provider error, detail in
// `error`). The internal rejection reason never goes into the email — only
// HR-approved `remarks` do (see lib/hiring-email.ts).
model MailOutbox {
  id        String   @id @default(cuid())
  // REJECTION (R3) | OFFER | WELCOME | INTERVIEW_INVITE (future milestones).
  kind      String
  // Null when the linked candidate is deleted (history is retained).
  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  toAddress String
  subject   String
  // Plain-text body as sent — the audit copy HR can re-read in the Outbox.
  body      String
  // QUEUED → SENT | SKIPPED | FAILED.
  status    String   @default("QUEUED")
  sentById  String   @default("")
  sentAt    DateTime?
  // Resend message id when actually delivered ("" otherwise).
  providerMessageId String @default("")
  // Provider error detail on FAILED (truncated to 500 chars).
  error     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([candidateId])
  @@index([status])
}

// P24 (PL-01) — the notification template master. One row per CUSTOMIZED
// event; the built-in defaults live in lib/notification-template.ts and a
// missing row (or a Reset) falls back to them byte-identically, so an
// unmigrated/drifted database keeps the exact pre-P24 strings. The event
// vocabulary itself is a code registry (NOTIFICATION_TEMPLATE_EVENTS) — the
// editor and the writers both read it, rows only ever hold overrides.
// Placeholders use {{name}} / {{ name }} substitution (single pass,
// replacements are never re-scanned); unknown names are refused at save
// time so a typo can never silently render empty in production mail.
model NotificationTemplate {
  id             String   @id @default(cuid())
  // Registry key — LEAVE_PENDING | LEAVE_DECIDED today; P25/P26/P40 events
  // (reminders, scheduler nudges, the exit questionnaire) join the same
  // registry as their epics land.
  eventKey       String   @unique
  // Email subject (the neutral, preview-safe line).
  subjectTemplate String
  // Email plain-text body — the audit copy the Outbox re-reads.
  bodyTemplate   String
  // In-app Notification.title.
  titleTemplate  String
  // In-app Notification.message.
  messageTemplate String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// R4 — joining-formalities document checklist. The workspace-level template:
// which documents HR collects from every joining candidate (ID, bank details,
// right to work, education certificates, previous-employment proof…).
// Admins can add / rename / reorder / disable types (hiring:config). Rows
// reference types by KEY so renaming a label never orphans a candidate's
// history — CandidateDocument snapshots the label at request time.
model DocumentTypeConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String   @default("")
  // Mandatory types are flagged in the UI and default-requested when the
  // joining-formalities panel opens for a SELECTED candidate.
  isMandatory Boolean  @default(false)
  // P36 (EM-21) — the scope axis: CANDIDATE (the joining-formalities
  // checklist, the pre-P36 meaning of every row) | EMPLOYEE
  // (identification types — passport, visa, IRD number…). The joining
  // gate deliberately applies CANDIDATE-scope mandatory types only.
  scope       String   @default("CANDIDATE")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([scope])
}

// One document being collected from one candidate.
// status: REQUESTED → RECEIVED → VERIFIED | REJECTED (back to RECEIVED on
// re-request after a rejection). fileRef is a reference (URL / file name) —
// no binary upload infra in v1.
model CandidateDocument {
  id         String    @id @default(cuid())
  candidateId String
  candidate  Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  // DocumentTypeConfig.key — stable identifier; label is a snapshot.
  docTypeKey String
  label      String
  // REQUESTED | RECEIVED | VERIFIED | REJECTED
  status     String    @default("REQUESTED")
  fileRef    String    @default("")
  remarks    String    @default("")
  requestedAt DateTime @default(now())
  receivedAt DateTime?
  verifiedById String   @default("")
  verifiedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([candidateId, docTypeKey])
  @@index([candidateId])
  @@index([status])
}

// P36 (EM-21) — one identification document being collected from one
// EMPLOYEE (the CandidateDocument twin). status: REQUESTED → RECEIVED →
// VERIFIED | REJECTED (a re-request after a rejection resets the row).
// fileRef is a reference (URL / file name) — no binary upload infra in v1,
// the CandidateDocument convention. The member themself may move their
// own row to RECEIVED (the self-service submission); verification stays
// HR-owned.
model EmployeeDocument {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("EmployeeDocuments", fields: [userId], references: [id], onDelete: Cascade)
  // DocumentTypeConfig.key — stable identifier; label is a snapshot.
  docTypeKey   String
  label        String
  // REQUESTED | RECEIVED | VERIFIED | REJECTED
  status       String    @default("REQUESTED")
  fileRef      String    @default("")
  remarks      String    @default("")
  requestedAt  DateTime  @default(now())
  receivedAt   DateTime?
  verifiedById String    @default("")
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, docTypeKey])
  @@index([userId])
  @@index([status])
}

// R4 — background verification (BGV) record. Research B: initiated around
// offer acceptance (T-14), vendor-run, result clears or flags the join.
// status: INITIATED → IN_REVIEW → CLEARED | FLAGGED. Multiple records per
// candidate are allowed (re-runs); the panel shows them newest-first.
model BackgroundCheck {
  id           String    @id @default(cuid())
  candidateId  String
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  vendor       String
  // INITIATED | IN_REVIEW | CLEARED | FLAGGED
  status       String    @default("INITIATED")
  reportRef    String    @default("")
  notes        String    @default("")
  initiatedById String   @default("")
  initiatedAt  DateTime  @default(now())
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([candidateId])
  @@index([status])
}

// R5 — per-role offer template: the salary structure HR configures once and
// generates offers from. Components are JSON (lib/offer-math.ts computes the
// math): each entry is a fixed annual amount or a percentage of the basic
// component, and is an employee earning, an employer contribution on top
// (KiwiSaver / PF / gratuity), or an employee-side deduction.
model OfferTemplate {
  id          String   @id @default(cuid())
  // Stable identifier for the role band (e.g. "senior_engineer").
  key         String   @unique
  label       String
  description String   @default("")
  // JSON: OfferComponent[] (kind/mode/amount/label/key).
  components  String   @default("[]")
  // JSON: string[] — benefits bullets (extra leave, training budget…).
  benefits    String   @default("[]")
  // Letter text with {{candidateName}}/{{position}}/{{workspaceName}}/
  // {{annualCtc}}/{{startDate}} placeholders (rendered at offer generation).
  letterTemplate String @default("")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// One offer for one candidate, generated from a template then negotiated.
// components is the EDITED copy (numbers HR and the candidate agreed on);
// templateLabel snapshots the source template so later template edits never
// rewrite a live offer. Status: DRAFT (R5) → SENT → SIGNED | DECLINED (R6:
// tokenized link + typed signature; the token/signature columns land with
// the schema now so R6 needs no migration).
model OfferRecord {
  id           String    @id @default(cuid())
  candidateId  String
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  templateId   String?
  // Snapshot of the source template's label at generation time.
  templateLabel String   @default("")
  // JSON: OfferComponent[] — the negotiated copy (editable while DRAFT).
  components   String    @default("[]")
  // JSON: string[] — benefits copied from the template (editable).
  benefits     String    @default("[]")
  // Rendered letter text (placeholders resolved; the R6 signing page shows
  // this + a snapshot of components as the immutable record).
  letterText   String    @default("")
  // F2.10 — the proposed join date HR negotiated with the candidate. Feeds
  // the {{startDate}} letter placeholder (F-R11: it rendered empty before)
  // and the printable appointment letter.
  startDate    DateTime?
  // DRAFT | APPROVED | SENT | SIGNED | DECLINED | EXPIRED.
  // F2.10 — APPROVED: a manager (hiring:approve, distinct from the HR
  // composer) must approve the draft before sendOffer will send it
  // (R11/D-20 four-eyes). EXPIRED: a SENT offer whose signing link passed
  // tokenExpiresAt — lapsed lazily on hiring reads (F-R5: expired links
  // stop counting as "awaiting" in the funnel).
  status       String    @default("DRAFT")
  notes        String    @default("")
  createdById  String    @default("")
  // F2.10 — who approved the draft and when (approvedById "" = not yet).
  approvedById String    @default("")
  approvedAt   DateTime?
  // R6 — single-use signing token (NULL while DRAFT; unique so a token
  // can address at most one offer) + typed-signature capture.
  token        String?   @unique
  tokenExpiresAt DateTime?
  signedAt     DateTime?
  signedName   String    @default("")
  signedIp     String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([candidateId])
  @@index([status])
}

// R7 — payroll (docs/RECRUITMENT_MODULE_PLAN.md §5, milestone R7). The
// employee's standing salary structure: annual components in the same shape
// as offers (lib/offer-math.ts resolves FIXED / % of basic), typically
// copied from the signed offer when the candidate joins. One ACTIVE
// structure per employee is expected; history is kept by flipping
// isActive=false when a revision takes over (effectiveFrom).
model SalaryStructure {
  id            String   @id @default(cuid())
  userId        String
  // JSON: OfferComponent[] — ANNUAL amounts (monthly = ÷12 at payslip time;
  // other cadences ÷ windowsInYear — P10 / PR-B05).
  components    String   @default("[]")
  notes         String   @default("")
  // P5 (PR-15/PR-B04, F3.2) — the flexible-benefit cap: the maximum ANNUAL
  // benefit amount this employee may elect (the benchmark's max_benefits).
  // 0 = no cap (the pre-P5 world had no benefits at all, so the default is
  // zero-behavior).
  maxBenefits   Float    @default(0)
  // P10 (PR-B05, PR-03's payroll_frequency) — the cadence this structure
  // pays on. Runs only snapshot structures whose frequency matches the
  // run's (the benchmark's frequency-matched assignment); amounts are
  // periodic per this cadence. MONTHLY keeps the historical behavior for
  // every pre-P10 row.
  frequency     String   @default("MONTHLY")
  // P23 (PR-03) — the workspace default package flag (the benchmark's
  // is_active/is_default pair; its is_default is hidden machinery at the
  // pin — Fernly gives it a real duty): at most ONE structure workspace-wide
  // carries it (saving one clears the previous, atomically); the structure
  // editor PREFILLS new structures from its components. Not employment
  // state: a retired default still prefills (the badge says "Default
  // package", never "current pay"). Default false = zero behavior change.
  isDefault     Boolean  @default(false)
  // P16 (PR-04 opening balances) — optional component-keyed YTD OPENING
  // rows (annual amounts earned before this system — the mid-fiscal-year
  // joiner's prior-employer YTD; the benchmark's SSA opening balances,
  // Fernly-shaped as structure data read at aggregate time). Stored shape:
  // [{key, label, side, amount}] (same merge discipline as payslip lines;
  // gross/net openings derive from the rows). Seeds the fiscal year that
  // contains this structure's effectiveFrom in the read-time aggregates
  // (lib/payslip-aggregates.ts); null = none (the default).
  openingYtd    Json?
  effectiveFrom DateTime @default(now())
  isActive      Boolean  @default(true)
  createdById   String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([isActive])

  // Phase 1B (G8) — the effective-dated assignment history that points at
  // this structure (see SalaryStructureAssignment).
  assignments SalaryStructureAssignment[]
}

// ---------------------------------------------------------------------------
// Phase 1B (G8) — EFFECTIVE-DATED SALARY ASSIGNMENTS.
//
// The pre-1B world resolved an employee's pay at run time by reading their
// single ACTIVE SalaryStructure directly — a revision was a mutation of that
// row (no history, no effective date). G8 gives every employee a timeline of
// assignments: [fromDate, toDate) windows, toDate null = current, at most one
// beginning on any given date (@@unique). A payroll run resolves the
// assignment in force at its window START (lib/payroll/resolve-assignment.ts)
// and pays from THAT assignment's structure — a backdated revision therefore
// re-prices the windows it covers, without rewriting paid history.
//
// base / variable are the effective-dated salary FACTS (annual NZD):
//   base    = the referenced structure's ANNUAL basic anchor
//             (computeOffer().basic — what PERCENT_OF_BASIC resolves against)
//   variable = the remaining annual EARNINGS total (allowances, bonuses,
//             percent components) — base + variable = annual earnings.
// Money math itself never reads them: gross still flows exclusively through
// windowEarningsFromStructure(structure.components) (the single source for
// every payslip line); base/variable drive the salary-history UI, the arrears
// detector (Phase 1B step 6) and reporting.
//
// reason records WHY the timeline moved: HIRE (backfill / joining), REVISION
// (market adjustment), PROMOTION, TRANSFER. Legacy compatibility: employees
// whose active structure has NO assignment row yet keep the pre-1B direct
// read (scripts/backfill-salary-assignments.ts materialises the rows).
// ---------------------------------------------------------------------------
model SalaryStructureAssignment {
  id          String   @id @default(cuid())
  // The employee (Fernly's User is the employee record — EmployeeProfile and
  // EmployeeTaxProfile hang off it 1:1).
  employeeId  String
  employee    User     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  structureId String
  structure   SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Restrict)

  // Effective from (inclusive). Unique per employee: two assignments can
  // never begin on the same date (resolution stays deterministic).
  fromDate    DateTime
  // Effective until (EXCLUSIVE); null = the current open assignment.
  toDate      DateTime?
  // The effective-dated salary facts (annual NZD) — see the block comment.
  base        Decimal  @db.Decimal(12, 2)
  variable    Decimal  @default(0) @db.Decimal(12, 2)

  // HIRE | REVISION | PROMOTION | TRANSFER
  reason      String?
  approvedById String?
  approvedAt  DateTime?

  createdAt   DateTime @default(now())
  createdById String

  @@index([employeeId, fromDate])
  @@unique([employeeId, fromDate])
}

// R7 — one payroll period per window (P10: any cadence; the unique
// `period` key names it — monthly "2026-11" was the pre-P10 shape and stays
// byte-identical). OPEN: payslips editable; LOCKED: the period was paid and
// every line is immutable (audit-grade finality for YTD).
model PayrollRun {
  id          String   @id @default(cuid())
  period      String   @unique
  status      String   @default("OPEN")
  lockedById  String   @default("")
  lockedAt    DateTime?
  createdById String   @default("")
  // P10 (PR-B05) — the cadence this run pays on (MONTHLY | BIMONTHLY |
  // WEEKLY | FORTNIGHTLY | DAILY | QUARTERLY | ANNUAL, lib/payroll-windows.ts)
  // and the run's real window [startDate, endDate] (UTC, inclusive). Dates
  // carry all temporal logic — ordering, YTD attribution, gratuity windows,
  // the leave salary-processed guard — because period strings do not sort
  // chronologically across cadences. Nullable: the migration backfills
  // every existing monthly row; readers fall back to parsing `period`
  // (runWindowStart/runWindowEnd) for rows that predate the backfill.
  frequency   String   @default("MONTHLY")
  startDate   DateTime?
  endDate     DateTime?
  // F1.1 — working days in the period (Mon–Fri minus holiday-calendar
  // entries, half-days = 0.5), denormalized at creation from the holiday
  // calendar and never re-derived: payslip LOP math divides by THIS number.
  // Float because a half-day holiday makes the count fractional (0.5).
  // 0 = run created before F1.1 (column default) — readers fall back to the
  // calendar length of the month (lib/payroll-math.ts daysInPeriod).
  workingDays Float    @default(0)
  // NZ statutory engine (Phase 0) — the StatutoryRateSet this run resolved
  // at creation (latest set whose effectiveFrom <= the run's window start).
  // Snapshot discipline: later edits to the set never rewrite a frozen
  // run, and the payslip's statutory JSON carries the set's label for
  // display. "" = pre-engine rows (no statutory computation was applied).
  rateSetId   String   @default("")
  // Phase 1A — the TaxYear row covering this run's window (the NZ
  // April–March year), stored at creation so YTD-by-tax-year queries
  // group without re-deriving the boundary per row. "" = pre-Phase-1A
  // rows (readers fall back to fiscalYearOf on the window end).
  taxYearId   String   @default("")
  // Phase 2 (payday filing) — the PAYDAY: the day the payment for this
  // run is made. The EI file is filed per payday and the 2-working-day
  // filing deadline (TAA 1994 s 23D(4)) runs from THIS date, not from the
  // pay period's end. Explicit + editable at run creation (defaults to
  // endDate in the UI); the server guards payDate >= endDate and within
  // 7 days of endDate (ADR-018 documents the backfill: existing rows got
  // payDate = COALESCE(endDate, startDate, createdAt)).
  payDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payslips Payslip[]

  @@index([status])
}

// R7 — one payslip per employee per run. earnings/deductions are JSON
// PayslipLine[] copies (MONTHLY amounts), editable while the run is OPEN
// (fixes, bonuses, deductions). gross = Σ earnings; loss-of-pay
// (lopDays > 0) is an auto-managed "lop" deduction line =
// gross × lopDays / days-in-period (lib/payroll-math.ts); net =
// gross − Σ deductions. YTD totals are computed at read time from the
// same-year periods up to and including this run.
model Payslip {
  id         String    @id @default(cuid())
  runId      String
  run        PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId     String
  // Human slip number: PS-<period>-<seq> (unique workspace-wide).
  slipNo     String    @unique
  earnings   String    @default("[]")
  deductions String    @default("[]")
  // Optional per-slip note shown on the printed slip.
  note       String    @default("")
  // Loss-of-pay days in the period (drives the auto LOP deduction line).
  // Float (F1.4): HALF_DAY attendance and half-day holidays charge 0.5-day
  // (and 0.25-day) fractions.
  lopDays    Float     @default(0)
  // F1.4 — provenance of lopDays. AUTO: derived at run creation from
  // attendance (ABSENT/HALF_DAY) + unpaid approved leave, using the run's
  // holiday-aware denominator; never re-derived afterwards (snapshot
  // discipline — later attendance edits are corrected via a manual
  // override, not a silent re-derivation). MANUAL: an HR override saved
  // through updatePayslip (audited).
  lopSource  String    @default("AUTO")
  // P15 (PR-06) — the per-slip leave-charge breakdown frozen at creation
  // (the benchmark's Salary Slip Leave child, Fernly-shaped): which leave
  // spans covered the window ({code, name, takenDays, chargedDays,
  // fraction, paid}) plus the attendance-side docks (absentDays /
  // halfDays / unmarkedDays). Null = nothing docked, pre-P15, or a MANUAL
  // LOP override replaced the derivation.
  lopDetail  Json?
  // F-R2 (S1) — optimistic-lock version. A mismatch (someone else saved
  // while this editor was open) refuses the save; LOCKED slips never move.
  version    Int       @default(0)
  // PR-B06 (S5) — working days inside the employee's employment window
  // [max(period start, hireDate), min(period end, lastWorkingDay)],
  // snapshotted at run/slip creation; earnings scale by paidDays/
  // workingDays. null = pre-S5 rows (read as full-period).
  paidDays   Float?
  gross      Float     @default(0)
  net        Float     @default(0)
  // P8 (PR-19/PR-B13) — "" = normal | WITHHELD = the net is held (YTD and
  // self-service exclude it) | RELEASED = paid out via a WITHHELD_RELEASE
  // adjustment in a later period (the money counts once, there).
  withholdStatus String @default("")
  // NZ statutory engine (Phase 0) — the frozen statutory computation
  // snapshot at creation: resolved tax code, rate-set id + label, the
  // per-line amounts (PAYE income tax, ACC earners' levy, KiwiSaver
  // employee/employer, ESCT, student loan repayment) and the inputs they
  // derived from (annualised earnings, applied thresholds). Deduction
  // lines ALSO ride the deductions JSON (keys "paye" / "acc" / "ks" /
  // "sl") so gross/net math is untouched; employer-side lines (employer
  // KiwiSaver, ESCT) live ONLY here — they never touch the employee's
  // earnings array. null = pre-engine slips (read as: statutory lines were
  // never computed for this slip).
  statutory    Json?
  // Phase 1A — the statutory snapshot's key facts as REAL columns so
  // SQL-level aggregation (employer-contribution YTD, tax-code reporting)
  // never has to parse JSON. Populated from the snapshot at creation and
  // on updatePayslip recomputes; defaults = pre-engine slips.
  taxCodeApplied         String   @default("")
  statutoryRuleVersion   String   @default("")
  // Employer-side KiwiSaver money (never docks net pay — display + IRD
  // filing only). Null = not computed / pre-engine.
  employerKiwiSaverGross Decimal? @db.Decimal(12, 2)
  employerEsct           Decimal? @db.Decimal(12, 2)
  employerKiwiSaverNet   Decimal? @db.Decimal(12, 2)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([runId, userId])
  @@index([userId])
}

// P1 (PR-12/PR-B10, F2.3) — the universal adjustment adapter (the
// benchmark's Additional Salary): every special payment flow (encashment,
// arrears deltas, LWP credits, retention bonus, benefit payouts, withheld
// release, manual incentives) funnels into ONE row, consumed by the run
// covering its period inside that run's creation transaction. Rows are
// INPUTS: slip lines snapshot at creation and manual slip edits never
// write back here (the standing snapshot discipline).
// ---------------------------------------------------------------------------
// P39 (EM-16's advances half, EX-03 lite) — salary advances: issue →
// installment recovery through the PayAdjustment adapter → the FnF
// receivable line. The recovery rides the P1 adapter as DEDUCTION-side
// RECURRING rows (sourceType SALARY_ADVANCE, sourceId this row); the run
// that consumes the final installment flips the row RECOVERED. Loans
// proper stay the later un-decline epic; claim/return combos ride the
// later expenses epic.
// ---------------------------------------------------------------------------
model SalaryAdvance {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation("SalaryAdvances", fields: [userId], references: [id], onDelete: Cascade)
  amount        Float
  currencyNote  String    @default("")
  // OPEN → RECOVERED (the final installment's consuming run flips it).
  status        String    @default("OPEN")
  // The number of equal installments the recovery splits into.
  installments  Int       @default(1)
  // First recovery period ("YYYY-MM").
  startPeriod   String
  reason        String    @default("")
  issuedById    String    @default("")
  issuedAt      DateTime  @default(now())
  recoveredAt   DateTime?
  // The adapter rows this advance spawned (denormalized count for the UI;
  // the rows themselves are the source of truth).
  adjustmentCount Int     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([status])
}

model PayAdjustment {
  id         String   @id @default(cuid())
  userId     String
  // Provenance: MANUAL | INCENTIVE | ENCASHMENT | ARREARS | LWP_CREDIT |
  // RETENTION_BONUS | BENEFIT_PAYOUT | WITHHOLDING_RELEASE. The literal
  // union + labels live in the pure kernel (lib/pay-adjustment.ts); the DB
  // keeps a plain string so new sources never need a migration.
  sourceType String   @default("MANUAL")
  // Pointer to the source row (e.g. a leave-encashment request); blank for
  // MANUAL/INCENTIVE rows created by hand.
  sourceId   String   @default("")
  // Catalog code when the line maps to a SalaryComponent (label/kind picked
  // up from the row); blank = the row's own label + side carry the meaning.
  componentCode String @default("")
  label      String   @default("")
  // EARNING | DEDUCTION — which slip array the resolved line lands in.
  side       String   @default("EARNING")
  // ONE_SHOT: consumed once. RECURRING: re-emitted every period through
  // endPeriod inclusive (lastConsumedPeriod tracks progress; the row only
  // flips CONSUMED at its final period — intermediate runs leave it
  // PENDING). OVERWRITE: replaces the amount of the same-key line on the
  // slip for its single period.
  recurrence String   @default("ONE_SHOT") // ONE_SHOT | RECURRING | OVERWRITE
  // FIXED amount | PERCENT_OF_GROSS | PERCENT_OF_NET of the payslip the
  // line lands on — resolved by the two-pass kernel (gross-based lines
  // first, percent-of-net deductions sequentially afterwards; no
  // fixed-point iteration).
  calcMode   String   @default("FIXED")
  percent    Float?
  // Positive magnitude; `side` gives the direction (deductions ride the
  // deductions array as positive amounts, like the auto LOP line).
  amount     Float    @default(0)
  // First period ("YYYY-MM") the row applies to.
  period     String
  // RECURRING only: last period inclusive (null = open-ended).
  endPeriod  String?
  // Idempotency watermark: the last period this row was consumed in (one
  // run per period makes double-consumption impossible; this column makes
  // it verifiable).
  lastConsumedPeriod String @default("")
  // PENDING | CONSUMED | SKIPPED. SKIPPED carries skipReason (e.g. "no
  // payslip for the employee in this run") — refused input rows stay
  // visible instead of vanishing.
  status     String   @default("PENDING")
  skipReason String   @default("")
  note       String   @default("")
  createdById String  @default("")
  // The run that consumed the row (blank while PENDING; the RECURNING
  // intermediate case records the LAST consuming run).
  consumedRunId String @default("")
  // P4 (PR-14/PR-B12, F3.1) — the day-quantity the source row moved (null =
  // not a day-denominated source). LWP_CREDIT rows carry the reversed LOP
  // days here so the per-slip reversal cap can be enforced without
  // note-parsing (the honest-data version of provenance).
  sourceDays  Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([period, status])
  @@index([userId, status])
}

// P5 (PR-15–18, PR-B04, F3.2) — the flexible-benefits mini-ledger.
//
// Election (yearly, per employee × component, capped by the structure's
// maxBenefits): BenefitElection rows are the standing input.
//
// Accrual (append-only, per LOCKED run): locking a run writes one ACCRUAL
// row per active election — annualAmount ÷ 12, scaled to the slip's paid
// days (S5's window discipline, benefits accrue on paid days only).
//
// Claims: an HR-filed claim (single-step, audited — F2.8 generalizes the
// member-claim flow) consumes the accrued balance with a negative CLAIM row
// and pays through the P1 adapter (BENEFIT_PAYOUT adjustment).
model BenefitElection {
  id            String   @id @default(cuid())
  userId        String
  year          Int
  componentCode String
  label         String   @default("")
  // The ANNUAL elected amount (accrual = ÷ 12, paid-days-scaled).
  annualAmount  Float
  // ACTIVE | CANCELLED (a cancelled election stops future accrual; the
  // accrued balance stays claimable).
  status        String   @default("ACTIVE")
  createdById   String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, year, componentCode])
  @@index([userId, year, status])
}

model BenefitAccrual {
  id            String   @id @default(cuid())
  userId        String
  year          Int
  componentCode String
  // ACCRUAL (+, written at run lock) | CLAIM (−, written at claim approval).
  entryType     String
  delta         Float
  // ACCRUAL rows: the locking run's id. CLAIM rows: the claim's id.
  sourceId      String   @default("")
  period        String   @default("")
  note          String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, year, componentCode])
  @@index([sourceId])
}

// P8 (PR-19/PR-B13, F3.3) — salary withholding: hold an employee's
// salary over a window. ACTIVE window ⇒ runs whose period falls inside
// stamp their payslip withholdStatus="WITHHELD" (the slip is computed and
// frozen normally, but its net is NOT disbursed — YTD and self-service
// exclude it). Releasing emits one WITHHELD_RELEASE PayAdjustment per held
// slip (the held net, paid in the chosen release period) and flips the
// slips to "RELEASED" — the money pays exactly once, through the adapter.
model SalaryWithholding {
  id         String   @id @default(cuid())
  userId     String
  // First period ("YYYY-MM") the hold covers.
  fromPeriod String
  // Last covered period; null = open-ended until released.
  untilPeriod String?
  reason     String   @default("")
  // ACTIVE | RELEASED (releasing is terminal — a new hold is a new row).
  status     String   @default("ACTIVE")
  createdById String   @default("")
  // Release bookkeeping (RELEASED rows).
  releasedById String  @default("")
  releasedAt  DateTime?
  releasePeriod String @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, status])
}

// P7 (PR-20/PR-21, F3.3) — the gratuity rule. One row per workspace (the
// singleton read is findFirst): enabled off by default, the earnings basis
// is the average monthly gross of the last `averagingMonths` LOCKED-run
// payslips (falls back to the active structure's gross when no payslip
// exists yet). The years→fraction slabs live in GratuitySlab; the payout
// line is computed into the live full-and-final statement (lib/gratuity.ts
// kernel) with an explicit non-statutory disclaimer — this is the
// contractual rule the workspace configured, never a statutory regime.
model GratuityRule {
  id             String   @id @default(cuid())
  enabled        Boolean  @default(false)
  averagingMonths Int     @default(3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// One years→fraction band: service years y ∈ [fromYears, toYears ?? ∞]
// pay `fraction` months of average earnings each completed year. Years
// covered by no slab pay 0 (the honest skip, visible in the statement's
// gratuity note) — an uncovered year is a real rule choice, not an error.
model GratuitySlab {
  id       String  @id @default(cuid())
  fromYears Int
  toYears  Int?
  fraction Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fromYears])
}

// ---------------------------------------------------------------------------
// NZ statutory payroll engine — Phase 0 (schema layer).
//
// Two concerns, both SUPER_ADMIN-managed through the Phase 3 admin UI
// (permission statutory:manage):
//
//   1. RATE SETS — effective-dated master data for every NZ statutory
//      deduction. One StatutoryRateSet row per named window (e.g. "NZ
//      FY2026-27"); the child tables below carry the component parameters.
//      A payroll run resolves the set covering its window start: the
//      LATEST set whose effectiveFrom <= run start, within its half-open
//      [effectiveFrom, effectiveTo) validity window. No covering set => the
//      run is refused with a clear error — never a silent fallback to a
//      stale set. Sets are seeded (scripts/seed-statutory.js) with IRD
//      primary-source values and editable only by SUPER_ADMIN.
//
//   2. EMPLOYEE TAX PROFILES — per-employee IR330 elections (tax code,
//      KiwiSaver, STC certificate rates) consumed by the Phase 1 pure
//      engine alongside the resolved rate set.
//
// Calculation-method note (verified against IR341 Apr 2026 monthly tables):
// PAYE for primary codes = income-tax slabs applied to ANNUALISED
// period earnings, de-annualised, with the ACC earners' levy computed
// SEPARATELY on period earnings (rate x min(earnings, cap /
// windows-in-year) — e.g. monthly $15,000 -> $4,106.46 slab tax + $228.43
// levy = $4,334.89, table-identical). Storing income tax and the levy as
// separate parameters lets every statutory line round and display
// independently (per-line 2dp half-up, user decision) while reproducing
// the IRD table totals exactly.
//
// Secondary-code rates are stored income-tax-only — IRD publishes them
// "before ACC levies" (verified FY2026-27: SB 10.5 / S 17.5 / SH 30 /
// ST 33 / SA 39 / ND 45).
// ---------------------------------------------------------------------------

// The named, effective-dated bundle of statutory parameters. isCurrent is
// the UI's spotlight (at most one true — seed + Phase 3 UI enforce); the
// resolver itself works purely off effectiveFrom/effectiveTo.
// Phase 1A — the versioned statutory rule (ADR-015: rule versioning IS
// rate-set versioning). Renamed from StatutoryRateSet for the Phase 1A
// vocabulary (the /settings/tax/rules admin page); @@map keeps the
// canonical table name so the migration history is untouched.
model StatutoryRule {
  id            String    @id @default(cuid())
  label         String    @unique // "NZ FY2026-27 (1 Apr 2026 - 31 Mar 2027)"
  country       String    @default("NZ")
  // Half-open validity window [effectiveFrom, effectiveTo); effectiveTo
  // null = open-ended (the latest set). Seeded FY boundaries are UTC
  // midnights of 1 April — NZ's tax year boundary.
  effectiveFrom DateTime
  effectiveTo   DateTime?
  isCurrent     Boolean   @default(false)
  notes         String    @default("")
  createdById   String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  payeTiers      TaxSlab[]
  secondaryRates StatutorySecondaryRate[]
  accLevy        StatutoryAccLevy?
  ietc           StatutoryIetc?
  kiwiSaver      StatutoryKiwiSaver?
  esctTiers      StatutoryEsctTier[]
  studentLoan    StatutoryStudentLoan?

  @@index([effectiveFrom])
  @@map("StatutoryRateSet")
}

// Phase 1A — the NZ tax-year registry (1 April → 31 March). PayrollRun
// stores taxYearId at creation so YTD and statutory aggregation can group
// by the IRD tax year (the April boundary, not the calendar year).
model TaxYear {
  id        String   @id @default(cuid())
  // "2026-27" — the IRD label for the year starting 1 April 2026.
  label     String   @unique
  startDate DateTime // UTC midnight, 1 April
  endDate   DateTime // UTC midnight of 31 March (inclusive last day)
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Primary-code (M / ME) income-tax slabs — ANNUAL brackets, marginal
// rates, income tax ONLY (the ACC levy is a separate line, see
// StatutoryAccLevy). FY2026-27 seed: 10.5% to $15,600 / 17.5% to
// $53,500 / 30% to $78,100 / 33% to $180,000 / 39% above.
// Renamed from StatutoryPayeTier for the Phase 1A vocabulary (the
// /settings/tax/slabs admin page); @@map keeps the table name.
model TaxSlab {
  id         String            @id @default(cuid())
  setId      String
  set        StatutoryRule     @relation(fields: [setId], references: [id], onDelete: Cascade)
  // Tier applies to annualised income in [fromAnnual, toAnnual ?? inf).
  // fromAnnual is the lower bound (= the previous tier's toAnnual); the
  // first tier starts at 0.
  fromAnnual Float
  toAnnual   Float?
  // Marginal income-tax rate (0.105 = 10.5%).
  rate       Float
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([setId, fromAnnual])
  @@index([setId])
  @@map("StatutoryPayeTier")
}

// Secondary-code flat rates, income tax only (IRD: "before ACC levies").
// FY2026-27 seed: SB 0.105 / S 0.175 / SH 0.30 / ST 0.33 / SA 0.39 /
// ND 0.45. Codes beyond these (CAE / NSW / EDW) have no flat rate — they
// are valid IR330 declarations but ride other treatments; the Phase 1
// engine decides them explicitly instead of guessing here.
// SH2 / ST2 were retired by IRD and are rejected at the zod boundary.
model StatutorySecondaryRate {
  id        String            @id @default(cuid())
  setId     String
  set       StatutoryRule     @relation(fields: [setId], references: [id], onDelete: Cascade)
  code      String // SB | S | SH | ST | SA | ND
  rate      Float // flat income-tax rate (0.45 = 45% for ND)
  label     String            @default("")
  // Phase 3 (Task 3.1) — true = the stored rate ALREADY includes the ACC
  // earners' levy (a combined rate, e.g. the IRD lump-sum table's 12.25%
  // SB). The calculator then leaves the levy line at $0 instead of adding
  // it on top. Default false: the seeded rows are income tax only
  // ("before ACC levies", IRD).
  accInclusive Boolean        @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([setId, code])
  @@index([setId])
}

// ACC earners' levy — 1:1 with the set. Levy = rate x period liable
// earnings, capped per period at maxEarnings / windows-in-year
// (equivalently maxLevy annually). FY2026-27 seed: 1.75%, $156,641 cap,
// $2,741.22 max — all three published by IRD/ACC and mutually consistent
// (0.0175 x 156,641 = 2,741.2175 -> $2,741.22).
model StatutoryAccLevy {
  setId        String            @id @default(cuid())
  set          StatutoryRule     @relation(fields: [setId], references: [id], onDelete: Cascade)
  rate         Float // 0.0175
  maxEarnings  Float // 156641 — annual liable-earnings cap
  maxLevy      Float // 2741.22 — published annual maximum levy
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

// IETC (Independent Earner Tax Credit) — the ME-code adjustment, 1:1 with
// the set. Full annualAmount for annualised income in [lowerBound,
// abateFrom]; abates at abateRate per dollar above abateFrom; exhausted at
// upperBound. FY2026-27 seed: $520 / $24,000 / $66,000 / $70,000 / 13c
// (verified: IR341 monthly ME @ $2,000 = M - $43.33).
model StatutoryIetc {
  setId         String            @id @default(cuid())
  set           StatutoryRule     @relation(fields: [setId], references: [id], onDelete: Cascade)
  annualAmount  Float // 520
  lowerBound    Float // 24000 — no credit below this annual income
  abateFrom     Float // 66000 — credit starts abating above this
  upperBound    Float // 70000 — credit fully abated at/above this
  abateRate     Float // 0.13 — cents abated per dollar above abateFrom
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

// KiwiSaver parameters — 1:1 with the set. FY2026-27 seed: default
// employee 3.5% (auto-enrolment default rose from 3% on 1 Apr 2026),
// employer compulsory 3.5%, allowed employee elections [3, 3.5, 4, 6, 8,
// 10] percent (3% remains legal for pre-existing elections; IR341's own
// table prints 3.5/4/6/8/10 columns).
model StatutoryKiwiSaver {
  setId                String            @id @default(cuid())
  set                  StatutoryRule     @relation(fields: [setId], references: [id], onDelete: Cascade)
  defaultEmployeeRate  Float // 0.035 — applies when no election recorded (user decision)
  // JSON array of allowed employee rates in PERCENT numbers, e.g.
  // [3, 3.5, 4, 6, 8, 10] — validated at the zod boundary.
  allowedEmployeeRates Json
  employerRate         Float // 0.035 — compulsory employer contribution
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

// ESCT tiers — employer superannuation contribution tax, banded on the
// employee's annual income PLUS gross employer contributions (previous or
// estimated year). FY2026-27 seed (verified, IR341 Apr 2026): 10.5% to
// $18,720 / 17.5% to $64,200 / 30% to $93,720 / 33% to $216,000 / 39%
// above.
model StatutoryEsctTier {
  id         String            @id @default(cuid())
  setId      String
  set        StatutoryRule     @relation(fields: [setId], references: [id], onDelete: Cascade)
  // Tier applies to annual (income + employer contributions) in
  // [fromAnnual, toAnnual ?? inf).
  fromAnnual Float
  toAnnual   Float?
  rate       Float
  sortOrder  Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([setId, fromAnnual])
  @@index([setId])
}

// Student loan — 1:1 with the set. Main job: rate over the per-period
// threshold (annualThreshold / windows-in-year — monthly $24,128 / 12 =
// $2,010.67, verified against the IR341 monthly SL column: $2,010.00 ->
// $0.00, $2,015.00 -> $0.52). Secondary: rate of gross pay, NO threshold
// (IRD: "the repayment threshold does not apply to secondary income").
// FY2026-27 seed: 12% / $24,128.
model StatutoryStudentLoan {
  setId           String            @id @default(cuid())
  set             StatutoryRule     @relation(fields: [setId], references: [id], onDelete: Cascade)
  rate            Float // 0.12
  annualThreshold Float // 24128
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

// ---------------------------------------------------------------------------
// NZ statutory payroll engine — Task 0.2 (revised): the employee's tax
// profile. One row per user (userId unique), owned by HR/ADMIN
// (payroll:manage) through the payroll module; the Phase 1 pure engine
// consumes it as input alongside the resolved rate set.
//
// Base fields (IRD number, tax code, casual flag, KiwiSaver election) were
// reconstructed for this revision — confirm at the Phase 0 review; the
// three STC fields below are verbatim per the user's Task 0.2-r1 spec.
// ---------------------------------------------------------------------------
model EmployeeTaxProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  // IRD number as declared on the IR330 (8-9 digits, plain; "" = not
  // recorded — the Phase 1 engine checksum-validates before use).
  irdNumber String   @default("")
  // IR330 (Aug 2026) vocabulary: M | ME | SB | S | SH | ST | SA | ND | STC |
  // CAE | NSW | EDW, optionally suffixed " SL". SH2/ST2 retired. Default
  // "M" — the no-declaration case is the explicit ND code.
  taxCode   String   @default("M")
  // True = irregular-hours casual employment (the CAE / NSW / EDW family);
  // the engine's casual path taxes each payment on its own annualisation.
  isCasual  Boolean  @default(false)
  // KiwiSaver election: ACTIVE + null rate = no recorded election (the rate
  // set's defaultEmployeeRate applies — 3.5% FY2026-27); NOT_ENROLLED /
  // OPTED_OUT = nothing deducted; ON_HOLIDAY = savings suspension;
  // NOT_ELIGIBLE = under-18/65+ (opt-in members keep an elected rate).
  kiwiSaverStatus          String    @default("ACTIVE")
  // Phase 1A vocabulary (renamed from kiwiSaverRate / employerKiwiSaverRate).
  // Null = no recorded election → the rate-set default; a persisted value
  // is the sticky evidence of an election or an auto-enrolment.
  kiwiSaverEmployeeRate   Decimal?  @db.Decimal(6, 4)
  kiwiSaverEmployerRate   Decimal?  @db.Decimal(6, 4)
  // Phase 1A — explicit SL declaration flag (OR'd with the IR330 suffix by
  // the engine adapter).
  studentLoan             Boolean   @default(false)
  // Phase 1A — declaration provenance: IR330 | ADMIN | IMPORTED.
  taxCodeSource           String    @default("")

  // --- STC support (Task 0.2-r1, verbatim per user spec) ---
  // IR23 tailored tax code certificate: the special rate replaces PAYE
  // while every other statutory line keeps computing normally.
  taxCodeSpecialRate Decimal? @db.Decimal(6, 4) // IR23 tailored rate, e.g. 0.18
  // "INC" (rate includes ACC) | "PLUS" (rate excludes ACC, add separately)
  stcAccTreatment    String?  @default("INC")
  // IR23 special student-loan repayment rate — overrides the standard 12%.
  stcStudentLoanRate Decimal? @db.Decimal(6, 4)
  // Phase 3 — the IR23 certificate's expiry date (the editor warns when
  // passed; a renewal is a new effectiveFrom save).
  stcCertificateExpiry DateTime?

  // --- Phase 3 (Task 3.4-r1) — Section A/C fields ---
  // The date this tax code declaration applies from (IR330 start date).
  taxCodeEffectiveFrom DateTime?
  // Fixed ESCT rate override (null = the ESCT tier lookup applies).
  esctRateOverride     Decimal?  @db.Decimal(6, 4)

  // --- Phase 3 — Section C: employment / casual status. ---
  // PERMANENT | CASUAL | TEMPORARY | CASUAL_AGRICULTURAL. Null = derive
  // from isCasual (the Phase 0/1 behaviour).
  employmentType            String?
  // Casual holiday pay paid WITH wages (the 8% on top arrangement) — the
  // statutory casual definition. Default true (conservative posture).
  casualHolidayPayInWages   Boolean   @default(true)
  employmentStartDate       DateTime?
  employmentEndDate         DateTime?
  // Phase 1A — auto-enrolment EXEMPTION reason code. Non-empty blocks the
  // 28-day / 3-month time rules from auto-enrolling.
  autoEnrolExemption        String    @default("")
  // Phase 1A — the materialised auto-enrolment due date (TEMPORARY: start
  // + TEMP_MAX_DAYS; CASUAL_AGRICULTURAL: day after
  // CASUAL_AGRI_MAX_MONTHS). Display-only; the engine recomputes at pay
  // time (the source of truth is the category + dates).
  autoEnrolDueDate          DateTime?

  effectiveFrom DateTime @default(now())
  notes        String   @default("")
  createdById  String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Phase 1C (G2) — GENERAL LEDGER.
//
// The double-entry core the payroll postings ride on:
//   • LedgerAccount      — the chart of accounts (code-keyed, tree-capable,
//                          isSystem rows are seed-owned and undeletable).
//   • AccountingPeriod   — the posting calendar ([startDate, endDate]
//                          inclusive, monthly in the seed). A closed period
//                          refuses every new posting; corrections happen via
//                          a REVERSAL entry in an open period.
//   • JournalEntry       — one dated, balanced entry (DRAFT | POSTED |
//                          REVERSED) with a source pointer (PAYROLL_RUN |
//                          ARREARS | MANUAL) for provenance, and the
//                          reversalOf self-link that pairs a correction to
//                          the original it negates.
//   • JournalEntryLine   — the debit/credit legs. Debits and credits are
//                          separate non-negative columns (never signed
//                          amounts) — the balance assertion is a SUM
//                          comparison, and a line never straddles sides.
//
// Posting discipline (lib/accounting/post-payroll-run.ts): a PayrollRun
// locks → one POSTED entry per run (idempotent on sourceType+sourceId),
// debiting salary expense and crediting the statutory liabilities + net
// pay clearing; the balance assert throws before anything is written.
// ---------------------------------------------------------------------------

model LedgerAccount {
  id       String   @id @default(cuid())
  code     String   @unique
  name     String
  // ASSET | LIABILITY | EQUITY | INCOME | EXPENSE
  type     String
  parentId String?
  parent   LedgerAccount?  @relation("AccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children LedgerAccount[] @relation("AccountTree")
  currency String   @default("NZD")
  isActive Boolean  @default(true)
  // True = seed/system-owned (the statutory payable set, the payroll expense
  // set): the chart editor refuses to delete them.
  isSystem Boolean  @default(false)
  lines    JournalEntryLine[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([parentId])
}

model AccountingPeriod {
  id        String   @id @default(cuid())
  startDate DateTime
  endDate   DateTime
  // Closed → every posting into this period is refused (closePeriod);
  // corrections go through a reversal entry in an OPEN period.
  isClosed  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  journalEntries JournalEntry[]

  @@index([startDate, endDate])
}

model JournalEntry {
  id         String   @id @default(cuid())
  date       DateTime
  memo       String?
  periodId   String
  period     AccountingPeriod @relation(fields: [periodId], references: [id])
  // PAYROLL_RUN | ARREARS | MANUAL — the module that minted the entry.
  sourceType String
  // The source row's id (e.g. the PayrollRun id) — provenance + the
  // idempotency key for payroll postings.
  sourceId   String?
  // DRAFT | POSTED | REVERSED. REVERSED marks an entry negated by a
  // reversal — its lines are immutable history, only the flag moved.
  status     String   @default("DRAFT")
  postedAt   DateTime?
  postedById String?
  // Set when this entry was reversed (who actioned it).
  reversedById String?
  // The reversal link: a correction entry points at the original it
  // negates; the original keeps its own lines byte-identical.
  reversalOfId   String?
  reversalOf     JournalEntry?  @relation("JeReversal", fields: [reversalOfId], references: [id])
  reversedBy     JournalEntry[] @relation("JeReversal")
  lines      JournalEntryLine[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([sourceType, sourceId])
  @@index([periodId])
  @@index([status])
}

model JournalEntryLine {
  id             String   @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        LedgerAccount @relation(fields: [accountId], references: [id])
  debit          Decimal  @default(0) @db.Decimal(12, 2)
  credit         Decimal  @default(0) @db.Decimal(12, 2)
  costCenter     String?
  employeeId     String?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([journalEntryId])
  @@index([accountId])
  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// Phase 2 (payday filing) — the employer's IRD filing identity. The
// workspace is single-tenant (the Workspace singleton is the whole
// company), so this is a SINGLETON row too (id "default"): the employer
// IRD number the EI/ED files carry, the payroll contact myIR names on an
// error, and the form-version stamps. Gateway Services (SOAP) is out of
// scope — CSV file upload to myIR is the only self-service route
// (ADR-018).
// ---------------------------------------------------------------------------
model PayrollSettings {
  id                      String   @id @default("default")
  // 9 digits, IRD mod-11 valid, never 000000000 (validated on save with
  // the spec-exact validator — see lib/ird/ird-number.ts).
  employerIrdNumber       String
  // The employer name as registered with IRD (informational; not filed).
  employerName            String
  // Blank unless a registered PAYE intermediary files on the employer's
  // behalf. Optional in HEI2 field 6; must be a valid IRD number or blank.
  payeIntermediaryIrd     String?
  // HEI2 fields 7-9 — IRD contacts this person when a file bounces.
  payrollContactName      String
  payrollContactPhone     String
  payrollContactEmail     String
  // HEI2 field 27 — e.g. "Fernly v1.0". Unique per package/version; no
  // commas, no employer information.
  payrollPackageIdentifier String
  // HEI2 field 28 — IRD requires exactly "0001".
  irFormVersionNumber     String   @default("0001")
  // Optional holiday-calendar override for the 2-working-day deadline
  // walk. Null = use the workspace HolidayCalendarEntry table (the
  // Phase 1A working-days kernel, lib/working-days.ts).
  nzBusinessHolidays      Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// Phase 2 — one Employment Information (EI) filing per employer per
// payday (HEI2 + DEI records; ADR-018). The exact generated bytes are
// frozen in fileContent (sha256 in fileHash) so the download a user
// uploads to myIR is provably the audited artefact. Status lifecycle:
// DRAFT → GENERATED → FILED → ACCEPTED | REJECTED; ACCEPTED → AMENDED
// only through the EIA2 amendment flow (PaydayAmendmentFiling).
// REJECTED may be regenerated (myIR: fix the file and upload again).
model PaydayFiling {
  id                String   @id @default(cuid())
  employerIrd       String
  payDate           DateTime
  periodStart       DateTime
  periodEnd         DateTime
  // IRD pay cycle code: WK | FT | MT | HM | DA (lib/ird/pay-cycle.ts —
  // spec-confirmed; QUARTERLY/ANNUAL have no code and refuse to file).
  payCycle          String
  status            String   @default("DRAFT")
  fileContent       String?
  fileHash          String?
  totalEmployeeLines Int      @default(0)
  totalGrossCents   Int      @default(0)
  totalPayeCents    Int      @default(0)
  totalKiwisaverEmployeeCents Int @default(0)
  totalKiwisaverEmployerNetCents Int @default(0)
  totalEsctCents    Int      @default(0)
  totalStudentLoanCents Int  @default(0)
  generatedAt       DateTime?
  generatedById     String?
  filedAt           DateTime?
  filedById         String?
  irdReference      String?
  acceptedAt        DateTime?
  rejectedAt        DateTime?
  irdErrorReport    String?
  // payDate + 2 working days (TAA 1994 s 23D(4)); weekends + public
  // holidays skipped through the Phase 1A working-days kernel.
  dueDate           DateTime
  overdueFlaggedAt  DateTime?
  // Set when an EIA2 amendment supersedes this filing (points at the
  // PaydayAmendmentFiling row). This filing's status flips to AMENDED.
  amendedByFilingId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  lines PaydayFilingLine[]

  @@unique([employerIrd, payDate])
  @@index([status])
  @@index([dueDate])
}

// Phase 2 — one EI detail line per payslip. payslipId is UNIQUE: a
// payslip can be filed in exactly one EI return, ever (the double-filing
// guard; the filing service refuses a second filing covering it and the
// constraint is the backstop). Amount columns are integer cents (no
// decimals ever reach an IRD file).
model PaydayFilingLine {
  id             String   @id @default(cuid())
  filingId       String
  filing         PaydayFiling @relation(fields: [filingId], references: [id], onDelete: Cascade)
  payslipId      String   @unique
  employeeId     String
  // "000000000" when the employee has not supplied one (tax code must
  // then be ND).
  employeeIrd    String
  // "Surname Firstnames", single space, no commas (EI field 3).
  employeeName   String
  taxCode        String
  employmentStart DateTime?
  employmentEnd   DateTime?
  periodStart    DateTime
  periodEnd      DateTime
  payCycle       String
  // Hours × 100. Fernly tracks paid days, not hours — filed as 0 per
  // the spec's explicit "Default 0 if not held" (DEI field 10; ADR-018).
  hoursPaidCents Int      @default(0)
  grossCents     Int
  priorGrossAdjCents Int  @default(0)
  notLiableAccCents  Int  @default(0)
  lumpSumIndicator   String @default("0")
  payeCents      Int
  priorPayeAdjCents Int  @default(0)
  childSupportCents Int  @default(0)
  childSupportCode  String?
  studentLoanCents  Int  @default(0)
  slcirCents        Int  @default(0)
  slborCents        Int  @default(0)
  kiwisaverEmployeeCents Int @default(0)
  kiwisaverEmployerNetCents Int @default(0)
  esctCents         Int @default(0)
  donationsCents    Int @default(0)
  familyTaxCreditCents Int @default(0)
  shareSchemeCents  Int @default(0)
}

// Phase 2 — one Employee Details (ED) notification per employee per
// event kind. A new joiner (kind NEW, HED2+DED+TED records carrying the
// KiwiSaver enrolment) and a departure (kind DEPARTING) are each filed at
// most once — @@unique([employeeId, kind]) is the never-notify-twice
// guard. Same status lifecycle as PaydayFiling minus AMENDED.
model EmployeeDetailsFiling {
  id             String   @id @default(cuid())
  employerIrd    String
  employeeId     String
  employeeIrd    String
  employeeName   String
  // NEW — employment started (ED before the first EI that includes them);
  // DEPARTING — employment ended (ED with the end date).
  kind           String
  status         String   @default("GENERATED")
  fileContent    String?
  fileHash       String?
  generatedAt    DateTime?
  generatedById  String?
  filedAt        DateTime?
  filedById      String?
  acceptedAt     DateTime?
  rejectedAt     DateTime?
  irdErrorReport String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([employeeId, kind])
  @@index([status])
}

// Phase 2 — an EIA2 amendment file (header + DTI/DAI pairs) correcting a
// filed EI. IRD allows any number of amendments per payday, so these are
// their own rows (the PaydayFiling unique [employerIrd, payDate] keeps
// exactly one ORIGINAL EI per payday); the original's status flips to
// AMENDED and its amendedByFilingId points here.
model PaydayAmendmentFiling {
  id                String   @id @default(cuid())
  originalFilingId  String
  employerIrd       String
  payDate           DateTime
  status            String   @default("GENERATED")
  fileContent       String?
  fileHash          String?
  correctionCount   Int      @default(0)
  generatedAt       DateTime?
  generatedById     String?
  filedAt           DateTime?
  filedById         String?
  acceptedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([originalFilingId])
  @@index([status])
}
