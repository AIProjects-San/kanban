# =============================================================================
# TLS-enabled nginx config (PR-25) — swap in when terminating TLS on nginx
# instead of a host-level proxy (Caddy) or an external load balancer.
#
# Usage:
#   1. Obtain certificates (Let's Encrypt):
#        sudo certbot certonly --standalone -d app.example.com
#      or place your CA-issued fullchain.pem / privkey.pem in ./deploy/certs/.
#   2. Copy this file over nginx.conf (or mount it) and add to the nginx
#      service in docker-compose.yml:
#        volumes:
#          - ./deploy/certs:/etc/nginx/certs:ro
#   3. `docker compose up -d` — nginx now serves 80 (redirect) + 443 (TLS).
#
# The ACME HTTP-01 challenge path stays open on :80 so certbot renewals work.
# =============================================================================

events {
    worker_connections 1024;
}

http {
    upstream fernly {
        server fernly-1:3000;
        max_fails 3;
        fail_timeout 30s;
    }

    server {
        listen 80;
        server_name app.example.com;

        # ACME challenge (certbot renewals) — must stay on plain HTTP.
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        # Everything else redirects to HTTPS.
        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen 443 ssl;
        http2 on;
        server_name app.example.com;

        ssl_certificate     /etc/nginx/certs/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
        ssl_prefer_server_ciphers off;
        ssl_session_cache   shared:SSL:10m;
        ssl_session_timeout 1d;

        location /health {
            access_log off;
            return 200 "ok\n";
            add_header Content-Type text/plain;
        }

        location = /upstream-health {
            access_log off;
            proxy_pass http://fernly/api/health;
            proxy_connect_timeout 3s;
            proxy_read_timeout 5s;
        }

        location / {
            proxy_pass http://fernly;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_connect_timeout 5s;
            proxy_send_timeout 30s;
            proxy_read_timeout 30s;
        }

        location /_next/static/ {
            proxy_pass http://fernly;
            proxy_hide_header Cache-Control;
            expires 1y;
            add_header Cache-Control "public, immutable";
        }
    }
}
