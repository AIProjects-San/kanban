# =============================================================================
# Fernly HR — environment contract (EXAMPLE — safe to commit, PR-45)
#
# Copy to `.env` and fill in real values. The real `.env` is git-ignored.
# This file documents every knob the application reads; keys without values
# are optional. See docs/DEPLOY.md §1.2 for the provisioning walk-through.
# =============================================================================

# ── Required in production — the app REFUSES to boot without these ───────────
# Managed Postgres (use the POOLER host for Supabase/Neon/RDS), or the
# bundled container via `docker compose --profile local-db`.
DATABASE_URL=postgresql://fernly:CHANGE_ME@db:5432/fernly
# 32+ random bytes (`openssl rand -base64 32`). Signs every session —
# rotating it logs everyone out. Never reuse the preview/dev value.
NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
# Public origin, exactly matching the TLS host (scheme + host, no slash).
NEXTAUTH_URL=https://your-production-domain.example
# Comma-separated origins allowed to invoke Server Actions (CSRF surface).
SERVER_ACTIONS_ALLOWED_ORIGINS=https://your-production-domain.example
# Optional fallback for reset/invite link base when NEXTAUTH_URL is unset.
# APP_URL=https://your-production-domain.example

# Postgres password for the compose `local-db` profile ONLY (unused with a
# managed database — the container reads it, the app does not).
POSTGRES_PASSWORD=CHANGE_ME

# ── Email (password reset) — without a key, reset mail is silently dropped ───
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MAIL_FROM="Fernly <onboarding@your-production-domain.example>"

# ── Redis (shared rate limiting, config cache, cross-instance locks) ─────────
# The compose default embeds the optional REDIS_PASSWORD slot on both sides;
# override wholesale when pointing at an external instance.
REDIS_URL=redis://:CHANGE_ME_OR_LEAVE_EMPTY@redis:6379
# Prefix for every key — isolates environments sharing one Redis.
REDIS_KEY_PREFIX=fernly:
# PR-33 (optional): require AUTH on the compose Redis. Setting this one
# variable wires redis-server --requirepass AND the app URL above.
# REDIS_PASSWORD=CHANGE_ME_openssl_rand_base64_24

# ── Cron + metrics ───────────────────────────────────────────────────────────
# Bearer token (>= 16 chars) for /api/cron/prune-audit (daily maintenance at
# 03:00 UTC: audit retention + expired-token/read-state purges) and for
# /api/metrics (Prometheus scrape). Without it maintenance returns 503 and
# metrics stays disabled — both visible in /api/health.
CRON_SECRET=CHANGE_ME_openssl_rand_base64_32

# ── Optional: error reporting (client + server) ──────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=            # git SHA or semver; empty = no release tag
# SENTRY_SAMPLE_RATE=1       # 0..1, default 1

# ── Optional: password breach-list check (PR-35, opt-in egress) ──────────────
# Either knob enables HIBP k-anonymity checks on all four password-SET flows
# (only a 5-char SHA-1 prefix ever leaves the server; fails open on errors).
# Requires egress to api.pwnedpasswords.com:443 — see DEPLOY.md §1.2.
# PASSWORD_BREACH_CHECK=1
# HIBP_API_KEY=

# ── Optional: HSTS commitments (PR-36, effectively irreversible) ─────────────
# Only enable when EVERY subdomain of the host serves HTTPS. preload implies
# includeSubDomains; submission to the preload list is a multi-month exit.
# HSTS_INCLUDE_SUBDOMAINS=1
# HSTS_PRELOAD=1

# ── Optional: CSP violation reporting + log verbosity ────────────────────────
# REPORT_URI=https://your-collector.example/csp
# LOG_LEVEL=info             # debug | info | warn | error

# ── Auth stack (PR-48 — auth migration, docs/AUTH_MIGRATION_PLAN.md) ─────────
# Which stack serves authentication. Single switch, readable by server AND
# client (baked at build time for the client — flipping it is a deployment
# action per the cutover runbook in docs/DEPLOY.md §3a, not a runtime
# toggle):
#   nextauth (default) — NextAuth v4 serves /api/auth/*; the Better Auth
#                        parallel stack at /api/auth-better/* is dormant.
#   better             — Better Auth 1.7 serves auth; v4 is kept one release
#                        as instant rollback (Phase 3 cutover).
# NEXT_PUBLIC_AUTH_STACK=nextauth
# Better Auth signing secret. Falls back to NEXTAUTH_SECRET during the
# parallel period so operators manage ONE secret; at the Phase 3 cleanup
# rename NEXTAUTH_SECRET → BETTER_AUTH_SECRET keeping the same value.
# BETTER_AUTH_SECRET=use_the_same_value_as_NEXTAUTH_SECRET

# ── Demo mode (development/preview ONLY — leave unset in production) ─────────
# NEXT_PUBLIC_SEED_DEMO=1    # show the demo quick-login panel on /login
# NEXT_PUBLIC_DEMO_PASSWORD=fernly123
# NEXT_PUBLIC_DEMO_ACCOUNTS=demo@fernly.app:Demo (Manager),member@fernly.app:Team Member

# Load-smoke / prod-smoke script knobs (SMOKE_PORT, SMOKE_EMAIL, LOAD_* …)
# are documented in the scripts themselves, not the app contract.
