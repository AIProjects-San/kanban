{
  "name": "fernly",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/run-with-env.sh next dev -p 3000 2>&1 | tee dev.log",
    "build": "bash scripts/run-with-env.sh next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/",
    "start": "bash scripts/run-with-env.sh bun .next/standalone/server.js 2>&1 | tee server.log",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "cucumber-js -c e2e/cucumber.mjs",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "db:push": "bash scripts/run-with-env.sh bunx prisma db push",
    "db:generate": "bash scripts/run-with-env.sh bunx prisma generate",
    "db:migrate": "bash scripts/run-with-env.sh bunx prisma migrate dev",
    "db:deploy": "bash scripts/run-with-env.sh bunx prisma migrate deploy",
    "db:status": "bash scripts/run-with-env.sh bunx prisma migrate status",
    "db:reset": "bash scripts/run-with-env.sh bunx prisma migrate reset",
    "db:seed": "SEED_DEMO=1 bash scripts/run-with-env.sh node scripts/seed.js"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@prisma/client": "^6.11.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "docx": "^9.15.0",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "next-auth": "^4.24.11",
    "prisma": "^6.11.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.0.2",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "jsdom": "^30.1.3",
    "selenium-webdriver": "^4.51.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "description": "Fernly — project management workspace (Next.js 16 App Router, Prisma, NextAuth)"
}